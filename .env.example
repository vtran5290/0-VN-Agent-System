# Copy to .env and fill. Do not commit .env.
# FRED API key (free): https://fred.stlouisfed.org/docs/api/api_key.html
# Used by: src/intake/auto_inputs_global.py, scripts/fetch_global.py, make ingestion
FRED_API_KEY=your_key_here

# FireAnt Bearer token (JWT only, no "Bearer " prefix). Used by: fetch_fundamentals_raw, fireant_fetcher.
FIREANT_TOKEN=

# Optional: licensed/official ICE U.S. Dollar Index closing level (manual operator input only).
# Pipeline does not fetch commercial ICE/NYSE feeds. Used for audit row `dxy_ice_official` only.
ICE_DXY_OFFICIAL_VALUE=
ICE_DXY_OFFICIAL_VALUE_DATE=

# Optional: public article URL for Vietnam OMO fallback when SBV static HTML has no OMO table.
TBNN_OMO_ARTICLE_URL=

# Vietnam liquidity provider (OMO/interbank/credit/FX) used by scripts/update_manual_inputs.py.
# Tier-A (existing): SBV scrape.
# Tier-B (experimental): SStock (may require auth cookie / better-auth session).
# Tier-A + field-level fallback: set VIETNAM_MACRO_PROVIDER=auto.
# Shadow mode: runs SStock for comparison but keeps SBV chosen values.
VIETNAM_MACRO_PROVIDER=existing
VIETNAM_MACRO_SSTOCK_SHADOW=false

# SStock auth injection (do NOT hardcode secrets in code; provide via env).
# Either:
#   - SSTOCK_COOKIE / SSOCKT_COOKIE: full Cookie header value (e.g. better-auth.session-token=...)
#   - SSOCKT_SESSION_TOKEN / SSTOCK_SESSION_TOKEN: token value injected into better-auth.session-token
SSOCKT_COOKIE=
SSOCKT_SESSION_TOKEN=
SSTOCK_COOKIE=
SSTOCK_SESSION_TOKEN=

# --- Auto-trading (src/trading) — copy to .env; never commit .env ---
# Broker: paper | dnse (dnse is placeholder; no real orders in v1)
BROKER=paper
# LIVE_TRADING=false: no broker submission; DRY_RUN=true: log only, no broker call
LIVE_TRADING=false
DRY_RUN=true
# Required for future live DNSE orders: CONFIRM_LIVE_BROKER=DNSE + LIVE_TRADING=true + DRY_RUN=false
CONFIRM_LIVE_BROKER=
# Risk limits (override config/trading.yaml)
# TRADING_MAX_ORDER_VALUE_VND=500000000
# TRADING_MIN_ADV50_VND=500000000
# TRADING_MAX_POSITION_PCT_NAV=0.10
# DNSE credentials (do not use until live integration phase)
# DNSE_USERNAME=
# DNSE_PASSWORD=
# Optional: single symbol for placeholder strategy integration test
# TRADING_PLACEHOLDER_SYMBOL=
