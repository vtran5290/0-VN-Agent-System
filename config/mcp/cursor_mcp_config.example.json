{
  "mcpServers": {
    "local-quant-engine": {
      "type": "stdio",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["${workspaceFolder}/scripts/mcp_quant_engine.py"],
      "envFile": "${workspaceFolder}/.env"
    },
    "fred-mcp-server": {
      "type": "stdio",
      "command": "node",
      "args": ["${workspaceFolder}/mcp/fred-mcp/start.mjs"],
      "cwd": "${workspaceFolder}/mcp/fred-mcp",
      "envFile": "${workspaceFolder}/.env"
    },
    "serena": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide",
        "--project-from-cwd"
      ],
      "cwd": "${workspaceFolder}"
    }
  }
}
