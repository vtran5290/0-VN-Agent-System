///////////////////////////////////////////////////////////////////////////////
// Leader Watchlist Dashboard
// Converted from: SMC_Donchian_EMA_Cloud_fixed_full.afl
// Purpose : GK_FAST trend ribbon + leader watchlist markers
//           C06 / Don252 / Near52VE / Don20 / VolExp
//           + GK_SELL / TS20 exit context
// Phase 8 verdict: WATCHLIST + EXIT OVERLAY
// Backtest : DISABLED (Buy=0, Sell=0, Short=0, Cover=0)
///////////////////////////////////////////////////////////////////////////////

///////////////////////////////////////////////////////////////////////////////
// 00_GLOBAL
///////////////////////////////////////////////////////////////////////////////
_SECTION_BEGIN("00_GLOBAL");

SetChartOptions(0, chartShowDates | chartShowArrows);
GraphXSpace = Param("GraphXSpace", 5, 0, 30, 1);
SetBarsRequired(300, 0);

bi    = BarIndex();
last  = BarCount - 1;
atr14 = ATR(14);

_SECTION_END();

///////////////////////////////////////////////////////////////////////////////
// 01_PRICE
///////////////////////////////////////////////////////////////////////////////
_SECTION_BEGIN("01_PRICE");

upColor   = ColorRGB(0, 180, 80);
downColor = ColorRGB(220, 50, 50);

SetBarFillColor(IIf(C >= O, upColor, downColor));
Plot(C, "Price", IIf(C >= O, upColor, downColor), styleCandle | styleNoTitle);

lc = LastValue(C);
PlotText(WriteVal(lc, 1.2), last + 1, lc, ColorRGB(160, 160, 160));

_SECTION_END();

///////////////////////////////////////////////////////////////////////////////
// 02_GK_FAST — Zero-Lag EMA ribbon
///////////////////////////////////////////////////////////////////////////////
_SECTION_BEGIN("02_GK_FAST");

GK_Len  = 100;
GK_Mult = 2.0;
GK_lag  = int((GK_Len - 1) / 2);   // = 49

GK_ZL = EMA(C + (C - Ref(C, -GK_lag)), GK_Len);
GK_GU = GK_ZL + ATR(14) * GK_Mult;
GK_GL = GK_ZL - ATR(14) * GK_Mult;

// Two consecutive closes on correct side + ZL direction
GK_BullCond = C > GK_GU AND Ref(C, -1) > Ref(GK_GU, -1) AND GK_ZL > Ref(GK_ZL, -1);
GK_BearCond = C < GK_GL AND Ref(C, -1) < Ref(GK_GL, -1) AND GK_ZL < Ref(GK_ZL, -1);

GK_Bull = Flip(GK_BullCond, GK_BearCond);
GK_Bear = NOT GK_Bull;

GK_Buy      = GK_Bull AND NOT Ref(GK_Bull, -1);
GK_Sell_Sig = GK_Bear AND NOT Ref(GK_Bear, -1);

// Band fill (cloud between GL and GU)
PlotOHLC(GK_GL, GK_GU, GK_GL, GK_GU, "",
         IIf(GK_Bull, ColorRGB(0, 70, 35), ColorRGB(80, 18, 18)),
         styleCloud | styleNoTitle);

// Band outlines
ribbonColor = IIf(GK_Bull, ColorRGB(0, 160, 75), ColorRGB(180, 45, 45));
Plot(GK_GU, "", ribbonColor, styleLine | styleNoTitle, Null, Null, 0, 0, 1);
Plot(GK_GL, "", ribbonColor, styleLine | styleNoTitle, Null, Null, 0, 0, 1);

// ZL centerline (thick)
Plot(GK_ZL, "", ribbonColor, styleLine | styleThick | styleNoTitle, Null, Null, 0, 0, 2);

_SECTION_END();

///////////////////////////////////////////////////////////////////////////////
// 03_SHARED_METRICS
///////////////////////////////////////////////////////////////////////////////
_SECTION_BEGIN("03_SHARED_METRICS");

ADV50_Bn     = MA(C * V, 50) / 1e9;
VolExp       = IIf(MA(C * V, 50) > 0, (C * V) / MA(C * V, 50), 0);
HHV52        = Ref(HHV(H, 252), -1);
Dist52wk_Pct = IIf(HHV52 > 0, C / HHV52 - 1, 0);
HHV20        = Ref(HHV(H, 20), -1);
RangePos     = IIf(H - L > 0, (C - L) / (H - L), 0.5);

VNX_C    = Foreign("VNINDEX", "C");
RegimeON = VNX_C > EMA(VNX_C, 100) AND EMA(VNX_C, 20) > EMA(VNX_C, 50);

RS1M = IIf(Ref(C, -21)  > 0 AND Ref(VNX_C, -21)  > 0,
           C / Ref(C, -21)  - VNX_C / Ref(VNX_C, -21),  0);
RS3M = IIf(Ref(C, -63)  > 0 AND Ref(VNX_C, -63)  > 0,
           C / Ref(C, -63)  - VNX_C / Ref(VNX_C, -63),  0);
RS6M = IIf(Ref(C, -126) > 0 AND Ref(VNX_C, -126) > 0,
           C / Ref(C, -126) - VNX_C / Ref(VNX_C, -126), 0);

// TS20: GK_Bull AND price 20 bars ago >= current (time-stop warning)
TS20_Cond       = GK_Bull AND Ref(C, -20) >= C;
TS20_Warn_Onset = TS20_Cond AND NOT Ref(TS20_Cond, -1);

_SECTION_END();

///////////////////////////////////////////////////////////////////////////////
// 04_LEADER_MARKERS
///////////////////////////////////////////////////////////////////////////////
_SECTION_BEGIN("04_LEADER_MARKERS");

C06_Signal      = GK_Buy AND VolExp >= 1.2 AND ADV50_Bn >= 2.0;
Don252_Signal   = C > HHV52 AND ADV50_Bn >= 2.0;
Don20_Signal    = C > HHV20 AND ADV50_Bn >= 2.0;
Near52VE_Signal = Dist52wk_Pct >= -0.15 AND VolExp >= 1.2 AND ADV50_Bn >= 2.0;
VolExp_Signal   = VolExp >= 1.2 AND ADV50_Bn >= 2.0;

// Stacked below-bar positions (ATR-scaled)
LM0 = L - 0.50 * atr14;   // C06
LM1 = L - 0.85 * atr14;   // Don252
LM2 = L - 1.20 * atr14;   // Near52VE
LM3 = L - 1.55 * atr14;   // Don20

// C06: bright green up triangle
PlotShapes(IIf(C06_Signal,      shapeUpTriangle,      shapeNone), colorBrightGreen,      0, LM0, 0);
// Don252: purple small square
PlotShapes(IIf(Don252_Signal,   shapeSmallSquare,     shapeNone), ColorRGB(148, 0, 211), 0, LM1, 0);
// Near52VE: gold small circle
PlotShapes(IIf(Near52VE_Signal, shapeSmallCircle,     shapeNone), colorGold,             0, LM2, 0);
// Don20: aqua small square
PlotShapes(IIf(Don20_Signal,    shapeSmallSquare,     shapeNone), colorAqua,             0, LM3, 0);

// VolExp: small yellow circle above bar (every bar with volume expansion)
PlotShapes(IIf(VolExp_Signal,   shapeSmallCircle,     shapeNone), colorYellow,           0, H + 0.25 * atr14, 0);

_SECTION_END();

///////////////////////////////////////////////////////////////////////////////
// 05_EXIT_MARKERS
///////////////////////////////////////////////////////////////////////////////
_SECTION_BEGIN("05_EXIT_MARKERS");

// GK_SELL onset: red down triangle above bar
PlotShapes(IIf(GK_Sell_Sig,     shapeDownTriangle,      shapeNone), colorRed,    0, H + 1.00 * atr14, 0);
// TS20 warning onset: orange small down triangle above bar
PlotShapes(IIf(TS20_Warn_Onset, shapeSmallDownTriangle, shapeNone), colorOrange, 0, H + 0.60 * atr14, 0);

_SECTION_END();

///////////////////////////////////////////////////////////////////////////////
// 06_WATCHLIST_INFO_LINE
///////////////////////////////////////////////////////////////////////////////
_SECTION_BEGIN("06_WATCHLIST_INFO_LINE");

if (Status("action") == actionIndicator)
{
    lb = BarCount - 1;

    ve_v   = VolExp[lb];
    rs1_v  = RS1M[lb] * 100;
    rs3_v  = RS3M[lb] * 100;
    rs6_v  = RS6M[lb] * 100;
    rpos_v = RangePos[lb] * 100;
    d52_v  = Dist52wk_Pct[lb] * 100;
    reg_v  = RegimeON[lb];
    gkb_v  = GK_Bull[lb];
    c06_v  = C06_Signal[lb];
    d252_v = Don252_Signal[lb];
    n52_v  = Near52VE_Signal[lb];
    d20_v  = Don20_Signal[lb];

    if (reg_v)  sReg  = "BULL";     else sReg  = "BEAR";
    if (gkb_v)  sGK   = "GK:ON";    else sGK   = "GK:off";
    if (c06_v)  sC06  = "C06:YES";  else sC06  = "C06:-";
    if (d252_v) sD252 = "D252:YES"; else sD252 = "D252:-";
    if (n52_v)  sN52  = "N52:YES";  else sN52  = "N52:-";
    if (d20_v)  sD20  = "D20:YES";  else sD20  = "D20:-";

    infoStr = "WATCHLIST | " + sReg + " | " + sGK
            + " | RS1M:" + NumToStr(rs1_v,  1.1) + "%"
            + " RS3M:"   + NumToStr(rs3_v,  1.1) + "%"
            + " RS6M:"   + NumToStr(rs6_v,  1.1) + "%"
            + " | VE:"   + NumToStr(ve_v,   1.2) + "x"
            + " Rng:"    + NumToStr(rpos_v, 1.0) + "%"
            + " 52wk:"   + NumToStr(d52_v,  1.1) + "%"
            + " | " + sC06 + "  " + sD252 + "  " + sN52 + "  " + sD20;

    GfxSetBkMode(1);
    GfxSetTextColor(colorWhite);
    GfxSetFont("Arial", 9, 700);
    GfxTextOut(infoStr, 5, 2);
}

_SECTION_END();

///////////////////////////////////////////////////////////////////////////////
// 07_TICKER_LABEL
///////////////////////////////////////////////////////////////////////////////
_SECTION_BEGIN("07_TICKER_LABEL");

if (Status("action") == actionIndicator)
{
    GfxSetBkMode(1);
    GfxSetTextColor(colorWhite);
    GfxSetFont("Arial", 13, 700);
    GfxTextOut(Name(), 5, 18);
}

_SECTION_END();

///////////////////////////////////////////////////////////////////////////////
// 08_DONCHIAN_EMA_CLOUD  [default: OFF]
///////////////////////////////////////////////////////////////////////////////
_SECTION_BEGIN("08_DONCHIAN_EMA_CLOUD");

ShowDonchian = ParamToggle("Show Donchian + EMA Cloud", "Off|On", 0);

if (ShowDonchian)
{
    EMA10  = EMA(C, 10);
    EMA20  = EMA(C, 20);
    EMA50  = EMA(C, 50);
    EMA100 = EMA(C, 100);
    EMA200 = EMA(C, 200);

    // EMA cloud (EMA20 vs EMA50)
    EMACldColor = IIf(EMA20 > EMA50, ColorRGB(0, 55, 28), ColorRGB(55, 0, 0));
    PlotOHLC(EMA20, EMA50, EMA20, EMA50, "", EMACldColor, styleCloud | styleNoTitle);

    Plot(EMA10,  "EMA10",  ColorRGB(100, 200, 255), styleLine | styleNoTitle, Null, Null, 0, 0, 1);
    Plot(EMA20,  "EMA20",  colorWhite,              styleLine | styleNoTitle, Null, Null, 0, 0, 1);
    Plot(EMA50,  "EMA50",  colorYellow,             styleLine | styleNoTitle, Null, Null, 0, 0, 1);
    Plot(EMA100, "EMA100", colorOrange,             styleLine | styleNoTitle, Null, Null, 0, 0, 1);
    Plot(EMA200, "EMA200", colorRed,                styleLine | styleNoTitle, Null, Null, 0, 0, 1);

    // Donchian channels (20-day and 252-day)
    DC20_H  = HHV(H, 20);   DC20_L  = LLV(L, 20);
    DC252_H = HHV(H, 252);  DC252_L = LLV(L, 252);

    Plot(DC20_H,  "DC20H",  colorAqua,   styleLine | styleNoTitle | styleDashed, Null, Null, 0, 0, 1);
    Plot(DC20_L,  "DC20L",  colorAqua,   styleLine | styleNoTitle | styleDashed, Null, Null, 0, 0, 1);
    Plot(DC252_H, "DC252H", colorYellow, styleLine | styleNoTitle | styleDashed, Null, Null, 0, 0, 1);
    Plot(DC252_L, "DC252L", colorYellow, styleLine | styleNoTitle | styleDashed, Null, Null, 0, 0, 1);
}

_SECTION_END();

///////////////////////////////////////////////////////////////////////////////
// 09_POCKET_PIVOT  [default: OFF]
///////////////////////////////////////////////////////////////////////////////
_SECTION_BEGIN("09_POCKET_PIVOT");

ShowPP = ParamToggle("Show Pocket Pivot", "Off|On", 0);

if (ShowPP)
{
    IsDownDay  = C < Ref(C, -1);
    MaxDownVol = Ref(HHV(IIf(IsDownDay, V, 0), 10), -1);
    PP_Signal  = V > MaxDownVol AND NOT IsDownDay AND ADV50_Bn >= 2.0;
    PlotShapes(IIf(PP_Signal, shapeUpArrow, shapeNone),
               colorLime, 0, L - 2.0 * atr14, 0);
}

_SECTION_END();

///////////////////////////////////////////////////////////////////////////////
// 10_DIST_DAY  [default: OFF — VNINDEX-based]
///////////////////////////////////////////////////////////////////////////////
_SECTION_BEGIN("10_DIST_DAY");

ShowDD = ParamToggle("Show Distribution Days", "Off|On", 0);

if (ShowDD)
{
    VNX_V  = Foreign("VNINDEX", "V");
    VNX_DD = VNX_C < Ref(VNX_C, -1) AND VNX_V > Ref(VNX_V, -1);
    PlotShapes(IIf(VNX_DD, shapeSmallDownTriangle, shapeNone),
               colorRed, 0, H + 1.6 * atr14, 0);
}

_SECTION_END();

///////////////////////////////////////////////////////////////////////////////
// 11_VAP  [default: OFF]
///////////////////////////////////////////////////////////////////////////////
_SECTION_BEGIN("11_VAP");

ShowVAP = ParamToggle("Show VAP", "Off|On", 0);

if (ShowVAP)
{
    VAPBars  = Param("VAP Lookback", 120, 20, 500, 10);
    nBuckets = 20;
    pMin     = LLV(L, VAPBars);
    pMax     = HHV(H, VAPBars);
    bSize    = (pMax - pMin) / nBuckets;
    maxVol   = 1;

    for (b = 0; b < nBuckets; b++)
    {
        bL   = pMin + b * bSize;
        bH   = bL + bSize;
        bVol = Sum(IIf(H >= bL AND L <= bH, V, 0), VAPBars);
        maxVol = Max(maxVol, bVol);
    }
    for (b = 0; b < nBuckets; b++)
    {
        bL   = pMin + b * bSize;
        bH   = bL + bSize;
        PlotOHLC(bL, bH, bL, bH, "",
                 ColorRGB(60, 100, 180), styleCloud | styleNoTitle | styleOwnScale);
    }
}

_SECTION_END();

///////////////////////////////////////////////////////////////////////////////
// 12_CHANDELIER  [default: OFF]
///////////////////////////////////////////////////////////////////////////////
_SECTION_BEGIN("12_CHANDELIER");

ShowChan = ParamToggle("Show Chandelier", "Off|On", 0);

if (ShowChan)
{
    ChanLen   = Param("Chandelier Length", 22, 10, 50, 1);
    ChanMult  = Param("Chandelier Mult",  3.0, 1.0, 5.0, 0.5);
    ChanHigh  = Ref(HHV(H, ChanLen), -1);
    ChanTrail = ChanHigh - ChanMult * ATR(ChanLen);
    Plot(IIf(GK_Bull, ChanTrail, Null), "",
         ColorRGB(255, 140, 0),
         styleLine | styleNoTitle | styleDashed, Null, Null, 0, 0, 1);
}

_SECTION_END();

///////////////////////////////////////////////////////////////////////////////
// 98_BACKTEST_DISABLE
///////////////////////////////////////////////////////////////////////////////
_SECTION_BEGIN("98_BACKTEST_DISABLE");

Buy   = 0;
Sell  = 0;
Short = 0;
Cover = 0;

_SECTION_END();

///////////////////////////////////////////////////////////////////////////////
// 99_EXPLORATION
///////////////////////////////////////////////////////////////////////////////
_SECTION_BEGIN("99_EXPLORATION");

ExploreMode = ParamList("Explore Filter",
    "All ADV50>=2B|Any Leader|C06 Only|Don252 Only|Near52VE Only|Don20 Only|Regime ON|GK Bull",
    0);

if      (ExploreMode == "All ADV50>=2B") Filter = ADV50_Bn >= 2.0;
else if (ExploreMode == "Any Leader")    Filter = (C06_Signal OR Don252_Signal OR Near52VE_Signal OR Don20_Signal) AND ADV50_Bn >= 2.0;
else if (ExploreMode == "C06 Only")      Filter = C06_Signal;
else if (ExploreMode == "Don252 Only")   Filter = Don252_Signal;
else if (ExploreMode == "Near52VE Only") Filter = Near52VE_Signal;
else if (ExploreMode == "Don20 Only")    Filter = Don20_Signal;
else if (ExploreMode == "Regime ON")     Filter = RegimeON AND ADV50_Bn >= 2.0;
else if (ExploreMode == "GK Bull")       Filter = GK_Bull AND ADV50_Bn >= 2.0;
else                                     Filter = ADV50_Bn >= 2.0;

// Cell color helpers
colADV = IIf(ADV50_Bn >= 10, colorBrightGreen,
         IIf(ADV50_Bn >=  2, colorGreen, colorDarkGray));

colVE_ = IIf(VolExp >= 1.5, colorBrightGreen,
         IIf(VolExp >= 1.2, colorGreen,
         IIf(VolExp >= 0.8, colorYellow, colorRed)));

colRS1 = IIf(RS1M*100 >=  5, colorBrightGreen,
         IIf(RS1M*100 >=  0, colorGreen,
         IIf(RS1M*100 >= -5, colorYellow, colorRed)));

colRS3 = IIf(RS3M*100 >= 10, colorBrightGreen,
         IIf(RS3M*100 >=  0, colorGreen,
         IIf(RS3M*100 >= -5, colorYellow, colorRed)));

colRS6 = IIf(RS6M*100 >= 15, colorBrightGreen,
         IIf(RS6M*100 >=  0, colorGreen,
         IIf(RS6M*100 >= -5, colorYellow, colorRed)));

colRng = IIf(RangePos >= 0.70, colorBrightGreen,
         IIf(RangePos >= 0.50, colorGreen, colorYellow));

colDst = IIf(Dist52wk_Pct >= -0.05, colorBrightGreen,
         IIf(Dist52wk_Pct >= -0.15, colorGreen,
         IIf(Dist52wk_Pct >= -0.30, colorYellow, colorRed)));

// Columns
AddTextColumn(Name(),          "Symbol");
AddColumn(C,                   "Close",     1.3);
AddColumn(ADV50_Bn,            "ADV50_Bn",  1.2, colorDefault, colADV);
AddColumn(VolExp,              "VolExp",    1.2, colorDefault, colVE_);
AddColumn(RS1M * 100,          "RS1M%",     1.1, colorDefault, colRS1);
AddColumn(RS3M * 100,          "RS3M%",     1.1, colorDefault, colRS3);
AddColumn(RS6M * 100,          "RS6M%",     1.1, colorDefault, colRS6);
AddColumn(RangePos * 100,      "RangePos%", 1.0, colorDefault, colRng);
AddColumn(Dist52wk_Pct * 100,  "Dist52wk%", 1.1, colorDefault, colDst);
AddColumn(GK_Bull,             "GK_Bull",   1.0, colorDefault,
    IIf(GK_Bull,         colorGreen,            colorDarkGray));
AddColumn(RegimeON,            "Regime",    1.0, colorDefault,
    IIf(RegimeON,        colorGreen,            colorRed));
AddColumn(C06_Signal,          "C06",       1.0, colorDefault,
    IIf(C06_Signal,      colorBrightGreen,      colorDarkGray));
AddColumn(Don252_Signal,       "Don252",    1.0, colorDefault,
    IIf(Don252_Signal,   ColorRGB(148,0,211),   colorDarkGray));
AddColumn(Near52VE_Signal,     "Near52VE",  1.0, colorDefault,
    IIf(Near52VE_Signal, colorGold,             colorDarkGray));
AddColumn(Don20_Signal,        "Don20",     1.0, colorDefault,
    IIf(Don20_Signal,    colorAqua,             colorDarkGray));
AddColumn(VolExp_Signal,       "VE_Flag",   1.0, colorDefault,
    IIf(VolExp_Signal,   colorYellow,           colorDarkGray));
AddColumn(GK_Sell_Sig,         "GK_Sell",   1.0, colorDefault,
    IIf(GK_Sell_Sig,     colorRed,              colorDarkGray));
AddColumn(TS20_Warn_Onset,     "TS20_Warn", 1.0, colorDefault,
    IIf(TS20_Warn_Onset, colorOrange,           colorDarkGray));

_SECTION_END();
