// ============================================================
// Cloud Strategy S3 — EMA21/55 — PAPER SHADOW BASE (Phase35)
// Version: PHASE35  |  Date: 2026-05-17
// Classification: PAPER_TRADE_SHADOW
//
// !! PAPER TRADE ONLY — NO REAL CAPITAL — NO DNSE ROUTE !!
//
// Phase35 base config (MAR=0.377, CAGR=7.9%, MaxDD=-21.0%):
//   TP1   = 18%           (base take-profit)
//   Trail = 3.5×ATR14
//   max_hold = 60 BARS    (HARD RULE — DO NOT CHANGE TO 250)
//   Universe = full 272 symbols
//   No mom20 gate, no breadth gate in base shadow
//   Regime gate: VNINDEX EMA20 > EMA100 (computed externally)
//
// S3 max_hold=250 → MAR=-0.011 → REJECTED_CONFIG. Never use 250.
// S3 max_hold=60  → MAR=0.377  → PAPER_TRADE_SHADOW (this config).
//
// SEPARATE PAPER GATE:
//   Track in: data/trading/s3_shadow_paper_trades.csv
//   Ledger: src/trading/live/s3_shadow_paper_ledger.py
//   P&L: SEPARATE from A3 and from S3 combo ledger.
//   12 months live evidence required before any production discussion.
//
// DO NOT MIX P&L WITH A3 PRODUCTION BOOK.
// DO NOT MIX WITH S3 COMBO PAPER LEDGER (s3_combo_paper_trades.csv).
// DO NOT ROUTE TO DNSE OR ANY LIVE BROKER.
// ============================================================

SetChartOptions(0, chartShowArrows | chartShowDates);
SetBarsRequired(120, 0);

// ── Parameters ──────────────────────────────────────────────

EMA_FAST   = Param("EMA Fast",   21, 10,  50,  1);
EMA_SLOW   = Param("EMA Slow",   55, 30, 150,  5);
ATR_PERIOD = Param("ATR Period", 14,  5,  30,  1);
TRAIL_MULT = Param("Trail Mult", 3.5, 1.0, 6.0, 0.5);
TP1_PCT    = Param("TP1 Pct (base=18%)", 0.18, 0.05, 0.50, 0.01);
MAX_HOLD   = Param("Max Hold (FIXED=60 — DO NOT CHANGE)", 60, 60, 60, 1);  // HARD RULE

// ── EMAs and Cloud ───────────────────────────────────────────

fast_ema   = EMA(C, EMA_FAST);
slow_ema   = EMA(C, EMA_SLOW);
cloud_bull = fast_ema > slow_ema;

// Entry: cloud flip + price above both EMAs + min 3 bear bars
bear_run     = BarsSince(cloud_bull) >= 3;
bear_to_bull = cloud_bull AND NOT Ref(cloud_bull, -1);
price_above  = C > fast_ema AND C > slow_ema;
entry_signal = bear_to_bull AND price_above AND Ref(bear_run, -1);

atr14      = ATR(ATR_PERIOD);
bars_since = BarsSince(entry_signal);
ep1        = ValueWhen(entry_signal, C);

// TP1 = 18% take-profit (base config)
tp1_lv     = ep1 * (1 + TP1_PCT);
highest    = HHV(C, IIf(bars_since > 0, bars_since, 1));

// Trail = 3.5×ATR14
trail      = highest - TRAIL_MULT * atr14;

// max_hold=60 force exit (HARD RULE)
max_hold_exit = bars_since >= MAX_HOLD;

// TP1 hit
tp1_hit    = C >= tp1_lv AND bars_since > 0 AND bars_since < MAX_HOLD;

// Trail exit
trail_exit = C < trail AND bars_since > 5 AND bars_since < MAX_HOLD;

// ── Liquidity ─────────────────────────────────────────────────

adv50_vnd = MA(C * V * 1000, 50);
adv50_B   = adv50_vnd / 1e9;
ema_dist  = (C - fast_ema) / fast_ema;

// ── Chart ────────────────────────────────────────────────────

Plot(C, "Close", colorBlack, styleCandle);
Plot(fast_ema, "EMA " + EMA_FAST, colorBlue, styleLine);
Plot(slow_ema, "EMA " + EMA_SLOW, colorRed,  styleLine);

// Cloud shading — teal for S3 paper (different from A3 green)
for (i = 1; i < BarCount; i++) {
    if (cloud_bull[i])
        PlotOHLC(fast_ema[i], fast_ema[i], slow_ema[i], slow_ema[i],
                 "", ColorRGB(0,160,160), styleCloud | styleNoLabel, 0, 0, 0, i);
    else
        PlotOHLC(fast_ema[i], fast_ema[i], slow_ema[i], slow_ema[i],
                 "", ColorRGB(160,100,0), styleCloud | styleNoLabel, 0, 0, 0, i);
}

PlotShapes(IIf(entry_signal,    shapeUpTriangle,   shapeNone), colorCyan,   0, L, -15);
PlotShapes(IIf(max_hold_exit,   shapeDownTriangle, shapeNone), colorOrange, 0, H,  15);
PlotShapes(IIf(trail_exit,      shapeDownTriangle, shapeNone), colorRed,    0, H,  20);
PlotShapes(IIf(tp1_hit,         shapeHollowUpTriangle, shapeNone), colorGreen, 0, H, 10);

Plot(IIf(bars_since > 0 AND bars_since < MAX_HOLD, trail,  Null),
     "Trail (3.5×ATR14)", colorPurple,      styleLine | styleDashed);
Plot(IIf(bars_since > 0 AND bars_since < MAX_HOLD, tp1_lv, Null),
     "TP1 +18% [BASE]",   colorBrightGreen, styleLine | styleDashed);

// ── Title ────────────────────────────────────────────────────

bars_to_max = MAX_HOLD - bars_since;

Title = EncodeColor(colorRed) +
        "S3 21/55 | PAPER_SHADOW | MaxHold=60 | TP1=18% | Trail=3.5x | NO REAL CAPITAL\n" +
        EncodeColor(colorYellow) +
        "EMA" + EMA_FAST + "/" + EMA_SLOW +
        "  Cloud: " + WriteIf(cloud_bull, "BULL", "BEAR") +
        "  MaxHold=60 (HARD — never 250)\n" +
        EncodeColor(colorCyan) +
        "EP1: " + WriteVal(ep1, 1.2) +
        "  TP1: " + WriteVal(tp1_lv, 1.2) + " (" + WriteIf(tp1_hit, "HIT", "pending") + ")" +
        "  Trail: " + WriteVal(trail, 1.2) + "\n" +
        EncodeColor(colorWhite) +
        "EMA Dist: " + WriteVal(ema_dist * 100, 1.1) + "%" +
        "  ADV50: " + WriteVal(adv50_B, 1.2) + "B VND\n" +
        EncodeColor(colorOrange) +
        "Bars since entry: " + WriteVal(bars_since, 1.0) +
        "  Max hold remaining: " + WriteVal(IIf(bars_since > 0, bars_to_max, MAX_HOLD), 1.0) + "\n" +
        EncodeColor(colorGrey) +
        "MAR=0.377 (max_hold=60). S3 max_hold=250 → MAR=-0.011 → REJECTED.\n" +
        "Track: data/trading/s3_shadow_paper_trades.csv. 12mo gate. Separate from A3.";

// ── Exploration ──────────────────────────────────────────────

Filter = entry_signal OR (bars_since > 0 AND bars_since <= MAX_HOLD);

AddTextColumn("PAPER_SHADOW",        "Status");
AddTextColumn("PAPER_TRADE_SHADOW",  "Classification");
AddColumn(C, "Close kVND", 1.2);
AddColumn(ema_dist * 100, "EMA Dist %", 1.2);
AddTextColumn(WriteIf(cloud_bull, "BULL", "BEAR"), "S3 Cloud");
AddColumn(bars_since, "Bars Since Entry", 1.0);
AddColumn(bars_to_max, "Max Hold Remaining", 1.0);
AddColumn(trail,  "Trail Stop (3.5×ATR14)", 1.2);
AddColumn(tp1_lv, "TP1 Level (18%)",        1.2);
AddTextColumn(WriteIf(max_hold_exit, "FORCE_EXIT_MAX60",
              WriteIf(trail_exit,    "TRAIL_EXIT",
              WriteIf(tp1_hit,       "TP1_HIT", "HOLD"))), "Exit Status");
AddColumn(adv50_B, "ADV50 B VND", 1.2);
AddTextColumn("NO_REAL_CAPITAL", "Capital Guard");
AddTextColumn("NO_DNSE",         "DNSE Guard");
AddTextColumn("max_hold_250_REJECTED", "max_hold=250 Config");
