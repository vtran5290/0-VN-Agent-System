<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>VN Weekly Report — {{ metadata.asof_date or 'N/A' }}</title>
  <style>
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
      margin: 0;
      padding: 0;
      background: #f5f6f8;
      color: #1a1d21;
      font-size: 14.5px;
      line-height: 1.65;
    }
    .report-container { display: flex; min-height: 100vh; }
    .sidebar {
      width: 220px;
      min-width: 220px;
      background: #f9fafb;
      border-right: 1px solid #e5e7eb;
      padding: 20px 0;
      position: sticky;
      top: 0;
      height: 100vh;
      overflow-y: auto;
    }
    .sidebar .nav-title {
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.05em;
      color: #9ca3af;
      padding: 8px 20px 12px;
      text-transform: uppercase;
    }
    .sidebar nav a {
      display: block;
      padding: 10px 20px;
      color: #374151;
      text-decoration: none;
      font-size: 13px;
      border-left: 3px solid transparent;
    }
    .sidebar nav a:hover {
      background: #f3f4f6;
      border-left: 3px solid #2563eb;
    }
    .sidebar nav a.active {
      font-weight: 600;
      color: #1d4ed8;
      background: #eff6ff;
      border-left: 3px solid #2563eb;
    }
    .main { flex: 1; padding: 24px 32px; max-width: 1200px; }
    header.report-header {
      background: #fff;
      border: 1px solid #e5e7eb;
      border-top: 4px solid #2563eb;
      border-radius: 8px;
      padding: 24px 28px;
      margin-bottom: 24px;
    }
    header.report-header h1 { font-size: 1.5rem; margin: 0 0 8px 0; color: #111827; }
    header.report-header .meta { font-size: 12px; color: #6b7280; }
    header.report-header .stale { color: #b45309; font-weight: 500; }
    .stale-prefix::before { content: "⚠ "; }
    section.card {
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      padding: 24px 28px;
      margin-bottom: 24px;
    }
    section.card h2 {
      font-size: 0.95rem;
      font-weight: 600;
      color: #111827;
      margin: 0 0 16px 0;
      border-left: 3px solid #2563eb;
      padding-left: 12px;
    }
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      gap: 12px;
      margin-bottom: 16px;
    }
    .kpi {
      background: #f9fafb;
      border-radius: 6px;
      padding: 16px;
      min-width: 140px;
      text-align: center;
      border: 1px solid #e5e7eb;
      border-left: 3px solid transparent;
    }
    .kpi.risk-high {
      background: #fef2f2;
      border-left-color: #b91c1c;
    }
    .kpi.risk-high .value { color: #b91c1c; }
    .kpi .label {
      font-size: 10px;
      letter-spacing: 0.05em;
      color: #9ca3af;
      text-transform: uppercase;
    }
    .kpi .value {
      font-size: 1.25rem;
      font-weight: 600;
      margin-top: 4px;
      color: #111827;
    }
    .badge {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 4px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.03em;
      margin-right: 6px;
      margin-bottom: 4px;
    }
    .badge-high { background: #fef2f2; color: #b91c1c; }
    .badge-medium { background: #fffbeb; color: #b45309; }
    .badge-low { background: #f0fdf4; color: #15803d; }
    .badge-regime { background: #eff6ff; color: #1d4ed8; }
    code {
      background: #f3f4f6;
      padding: 1px 6px;
      border-radius: 4px;
      font-size: 12.5px;
      color: #374151;
    }
    ul.flat { margin: 0; padding-left: 20px; }
    ul.flat li { margin-bottom: 6px; }
    table.data-table {
      table-layout: fixed;
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }
    table.data-table th,
    table.data-table td {
      padding: 8px 12px;
      text-align: left;
      border-bottom: 1px solid #e5e7eb;
    }
    table.data-table th { color: #6b7280; font-weight: 600; }
    table.data-table tbody tr:nth-child(even) { background: #f9fafb; }
    table.data-table tbody tr:hover { background: #eff6ff; cursor: default; }
    table.data-table.col-ticker-action .col-ticker { width: 15%; }
    table.data-table.col-ticker-action .col-action { width: 25%; }
    table.data-table.col-ticker-action .col-reason { width: auto; }
    .meta { color: #6b7280; font-size: 12.5px; }
    .chart-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 20px;
      margin-top: 8px;
    }
    .chart-wrap {
      position: relative;
      height: 260px;
      max-width: 100%;
    }
    .chart-caption {
      font-size: 11px;
      color: #6b7280;
      margin-top: 8px;
    }
    @media print {
      .sidebar { display: none; }
      .main { max-width: none; }
      .chart-wrap { break-inside: avoid; }
    }
  </style>
</head>
<body>
  <div class="report-container">
    <aside class="sidebar">
      <div class="nav-title">VN Weekly</div>
      <nav>
        <a href="#header">Header</a>
        <a href="#executive">Executive</a>
        <a href="#kpis">KPIs</a>
        <a href="#visualizations">Charts</a>
        <a href="#global-macro">Global macro</a>
        <a href="#vn-liquidity">VN liquidity</a>
        <a href="#market">Market structure</a>
        <a href="#regime">Regime</a>
        <a href="#decision">Decision</a>
        <a href="#watchlist">Watchlist</a>
        <a href="#execution">Execution</a>
        <a href="#portfolio-health">Portfolio health</a>
        <a href="#geo">Geo layer</a>
        <a href="#open">Open questions</a>
        <a href="#monitoring">Monitoring</a>
        <a href="#playbook">Playbook</a>
      </nav>
    </aside>
    <main class="main">
      <header class="report-header" id="header">
        <h1>VN Weekly Investment Report</h1>
        <p class="meta">As-of: {{ metadata.asof_date or 'N/A' }} · Generated: {{ metadata.generated_at or 'N/A' }} · Confidence: <span class="badge badge-{{ (metadata.data_confidence or 'Low')|lower }}">{{ metadata.data_confidence or 'Low' }}</span></p>
        {% if metadata.report_age_days is not none and metadata.report_age_days > 3 %}
        <p class="stale stale-prefix">WARNING: report is based on stale as-of date ({{ metadata.report_age_days }} days old)</p>
        {% endif %}
        {% if metadata.warnings %}
        <p class="meta">Warnings: {{ metadata.warnings|join('; ') }}</p>
        {% endif %}
      </header>

      <section class="card" id="executive">
        <h2>Executive summary</h2>
        <p><strong>Regime:</strong> {{ regime_engine.current_regime or 'N/A' }} (suggested: {{ regime_engine.suggested_regime or 'N/A' }}) {% if regime_engine.mismatch %}<span class="badge badge-medium">Mismatch</span>{% endif %}</p>
        <p><strong>Top actions</strong></p>
        <ul class="flat">
          {% for a in decision_layer.top_actions %}
          <li>{{ a }}</li>
          {% endfor %}
        </ul>
        <p><strong>Top risks</strong></p>
        <ul class="flat">
          {% for r in decision_layer.top_risks %}
          <li>{{ r }}</li>
          {% endfor %}
        </ul>
      </section>

      <section class="card" id="kpis">
        <h2>KPI tiles</h2>
        <div class="kpi-grid">
          <div class="kpi"><div class="label">UST 2Y <span class="meta">(FRED DGS2)</span></div><div class="value">{{ global_macro.facts.ust_2y|default('—') }}</div><div class="meta">obs {{ global_macro.facts.ust_2y_value_date|default('—') }}</div></div>
          <div class="kpi"><div class="label">UST 10Y <span class="meta">(FRED DGS10)</span></div><div class="value">{{ global_macro.facts.ust_10y|default('—') }}</div><div class="meta">obs {{ global_macro.facts.ust_10y_value_date|default('—') }}</div></div>
          <div class="kpi"><div class="label">DXY recon <span class="meta">(FRED 6 FX)</span></div><div class="value">{{ global_macro.facts.dxy_reconstructed|default('—') }}</div><div class="meta">obs {{ global_macro.facts.dxy_reconstructed_value_date|default('—') }}</div></div>
          <div class="kpi"><div class="label">DXY 3rd party <span class="meta">(Yahoo DX-Y.NYB)</span></div><div class="value">{{ global_macro.facts.dxy_third_party_proxy|default('—') }}</div><div class="meta">close {{ global_macro.facts.dxy_third_party_value_date|default('—') }}</div></div>
          <div class="kpi"><div class="label">DXY ICE official</div><div class="value">{{ global_macro.facts.dxy_ice_official|default('—') }}</div><div class="meta">{{ global_macro.facts.dxy_ice_official_value_date|default('—') }}</div></div>
          <div class="kpi"><div class="label">USD broad <span class="meta">(FRED DTWEXBGS)</span></div><div class="value">{{ global_macro.facts.usd_broad_index_fred|default('—') }}</div><div class="meta">obs {{ global_macro.facts.usd_broad_index_fred_value_date|default('—') }}</div></div>
          <div class="kpi"><div class="label">CPI YoY</div><div class="value">{{ global_macro.facts.cpi_yoy|default('—') }}</div><div class="meta">ref {{ global_macro.facts.cpi_reference_month|default('—') }} · {{ global_macro.facts.cpi_source|default('—') }}</div></div>
          <div class="kpi"><div class="label">Payroll MoM Δ</div><div class="value">{{ global_macro.facts.nonfarm_payroll_change_persons|default('—') }}</div><div class="meta">persons (PAYEMS)</div></div>
          <div class="kpi">
            <div class="label">VNINDEX {% if market_structure.levels.kpi_display_source | default('report_snapshot') == 'latest_market' %}(latest){% else %}(report snapshot){% endif %}</div>
            <div class="value">{{ market_structure.levels.vnindex_level|default('—') }}{% if market_structure.levels.kpi_is_stale | default(market_structure.levels.is_stale) | default(false) %} <span class="badge badge-medium">⚠ stale</span>{% endif %}</div>
          </div>
          <div class="kpi">
            <div class="label">VN30 {% if market_structure.levels.kpi_display_source | default('report_snapshot') == 'latest_market' %}(latest){% else %}(report snapshot){% endif %}</div>
            <div class="value">{{ market_structure.levels.vn30_level if market_structure.levels.vn30_level is not none else '—' }}{% if market_structure.levels.kpi_is_stale | default(market_structure.levels.is_stale) | default(false) %} <span class="badge badge-medium">⚠ stale</span>{% endif %}</div>
          </div>
          <div class="kpi"><div class="label">OMO net</div><div class="value">{{ vietnam_liquidity.facts.omo_net|default('—') }}</div><div class="meta">{{ vietnam_liquidity.facts.omo_net_verification|default('—') }}</div></div>
          <div class="kpi"><div class="label">Interbank ON</div><div class="value">{{ vietnam_liquidity.facts.interbank_on|default('—') }}</div></div>
          <div class="kpi"><div class="label">SBV ref USD/VND</div><div class="value">{{ vietnam_liquidity.facts.sbv_reference_usd_vnd|default(vietnam_liquidity.facts.fx_usd_vnd)|default('—') }}</div><div class="meta">central ref</div></div>
          <div class="kpi"><div class="label">Dist days</div><div class="value">{{ market_structure.levels.distribution_days_rolling_20 if market_structure.levels.distribution_days_rolling_20 is not none else '—' }}</div></div>
          <div class="kpi{% if (execution_monitoring.risk_flags.risk_flag or '')|lower == 'high' %} risk-high{% endif %}"><div class="label">Risk flag</div><div class="value">{{ execution_monitoring.risk_flags.risk_flag|default('—') }}</div></div>
        </div>
        {% if market_structure.levels.snapshot_date %}
        <p class="meta" style="margin-top:8px;">KPI source: {{ market_structure.levels.kpi_display_source | default('report_snapshot') }} · Date: {{ market_structure.levels.snapshot_date }}{% if market_structure.levels.kpi_is_stale | default(market_structure.levels.is_stale) | default(false) %} <span class="badge badge-medium">⚠ stale</span>{% endif %} · {{ market_structure.levels.source_name|default('—') }}</p>
        {% endif %}
      </section>

      <section class="card" id="visualizations">
        <h2>Visualizations</h2>
        <p class="meta">FACTS: charts derive from normalized weekly payload (same run as this page). Bond/FX WoW may be 0 if <code>manual_inputs_prev</code> matches current manual global fields.</p>
        <div class="chart-grid">
          <div>
            <p class="meta" style="margin-bottom:4px;"><strong>Global — WoW (UST bps, DXY pts)</strong></p>
            <div class="chart-wrap"><canvas id="chart-global-wow" aria-label="Global WoW"></canvas></div>
          </div>
          <div>
            <p class="meta" style="margin-bottom:4px;"><strong>Market — WoW (VNIndex pts, dist days)</strong></p>
            <div class="chart-wrap"><canvas id="chart-market-wow" aria-label="Market WoW"></canvas></div>
          </div>
          <div>
            <p class="meta" style="margin-bottom:4px;"><strong>Distribution days (LB≈25) by board</strong></p>
            <div class="chart-wrap"><canvas id="chart-dist-boards" aria-label="Distribution by board"></canvas></div>
          </div>
          <div>
            <p class="meta" style="margin-bottom:4px;"><strong>Scenario probabilities</strong></p>
            <div class="chart-wrap"><canvas id="chart-probs" aria-label="Probabilities"></canvas></div>
          </div>
          <div>
            <p class="meta" style="margin-bottom:4px;"><strong>Allocation (override)</strong></p>
            <div class="chart-wrap"><canvas id="chart-alloc" aria-label="Allocation"></canvas></div>
          </div>
          <div>
            <p class="meta" style="margin-bottom:4px;"><strong>Portfolio — sector %</strong></p>
            <div class="chart-wrap"><canvas id="chart-sectors" aria-label="Sector concentration"></canvas></div>
          </div>
        </div>
      </section>

      <section class="card" id="global-macro">
        <h2>Global macro</h2>
        <p>Facts: UST 2Y {{ global_macro.facts.ust_2y }} (obs {{ global_macro.facts.ust_2y_value_date|default('—') }}), UST 10Y {{ global_macro.facts.ust_10y }} (obs {{ global_macro.facts.ust_10y_value_date|default('—') }}), DXY recon {{ global_macro.facts.dxy_reconstructed|default('—') }}, DXY 3rd {{ global_macro.facts.dxy_third_party_proxy|default('—') }}, USD broad {{ global_macro.facts.usd_broad_index_fred|default('—') }}, CPI YoY {{ global_macro.facts.cpi_yoy if global_macro.facts.cpi_yoy is not none else '—' }} (ref {{ global_macro.facts.cpi_reference_month|default('—') }}), payroll MoM Δ {{ global_macro.facts.nonfarm_payroll_change_persons|default('—') }} persons, level {{ global_macro.facts.nonfarm_payroll_level_thousands|default('—') }}k</p>
        <p><strong>Bond / FX — What changed (WoW):</strong></p>
        <ul class="flat">
          {% for d in global_macro.what_changed %}
          <li>{{ d.metric }}: {% if d.delta_bps is not none %}{{ d.delta_bps }} bps{% else %}{{ d.delta|default('—') }}{% endif %} ({{ d.direction|default('—') }})</li>
          {% endfor %}
        </ul>
        <p class="meta">Để có WoW bond khác 0: cập nhật <code>data/raw/manual_inputs_prev.json</code> với UST 2Y, UST 10Y, DXY <strong>tuần trước</strong> (khác số liệu tuần này) rồi chạy <code>python -m scripts.run_full_weekly_cycle</code>.</p>
      </section>

      <section class="card" id="vn-liquidity">
        <h2>Vietnam liquidity</h2>
        <p>Facts: OMO net {{ vietnam_liquidity.facts.omo_net|default('—') }} ({{ vietnam_liquidity.facts.omo_net_verification|default('—') }}) · Interbank ON {{ vietnam_liquidity.facts.interbank_on|default('—') }} · Credit growth YoY {{ vietnam_liquidity.facts.credit_growth_yoy|default('—') }} · SBV ref USD/VND {{ vietnam_liquidity.facts.sbv_reference_usd_vnd|default(vietnam_liquidity.facts.fx_usd_vnd)|default('—') }}</p>
        {% if vietnam_liquidity.facts.omo_net_source_detail %}<p class="meta">OMO detail: {{ vietnam_liquidity.facts.omo_net_source_detail }}</p>{% endif %}
        {% if vietnam_liquidity.what_changed %}
        <p><strong>What changed (WoW):</strong></p>
        <ul class="flat">
          {% for d in vietnam_liquidity.what_changed %}
          <li>{{ d.metric }}: {{ d.delta|default('—') }} ({{ d.direction|default('—') }})</li>
          {% endfor %}
        </ul>
        {% else %}
        <p class="meta">WoW Vietnam: điền <code>data/raw/manual_inputs_prev.json</code> → vietnam (omo_net, interbank_on, credit_growth_yoy) tuần trước rồi chạy full weekly.</p>
        {% endif %}
      </section>

      <section class="card" id="market">
        <h2>Market structure</h2>
        <p><strong>KPI ({{ market_structure.levels.kpi_display_source | default('report_snapshot') }}):</strong> VNINDEX {{ market_structure.levels.vnindex_level|default('—') }}, VN30 {{ market_structure.levels.vn30_level if market_structure.levels.vn30_level is not none else '—' }}, Dist days {{ market_structure.levels.distribution_days_rolling_20 if market_structure.levels.distribution_days_rolling_20 is not none else '—' }} (proxy: {{ market_structure.levels.dist_proxy_symbol|default('—') }})</p>
        {% if market_structure.report_snapshot %}
        <p class="meta">Report snapshot (embedded): VNINDEX {{ market_structure.report_snapshot.vnindex_level|default('—') }}, date {{ market_structure.report_snapshot.date|default('—') }} — not current/latest when stale.</p>
        {% endif %}
        {% if market_structure.latest_market %}
        <p class="meta">latest_market_snapshot.json: VNINDEX {{ market_structure.latest_market.vnindex_level|default('—') }}, date {{ market_structure.latest_market.date|default('—') }} — {% if (market_structure.levels.kpi_display_source | default('report_snapshot')) == 'latest_market' %}used for KPI (on/after report snapshot date).{% else %}not used for KPI (file older than report snapshot or incomplete; KPI uses FireAnt report snapshot).{% endif %}</p>
        {% else %}
        <p class="meta">No latest_market snapshot; optional <code>data/decision/latest_market_snapshot.json</code> (asof_date ≥ report snapshot) to override KPI between runs.</p>
        {% endif %}
        <p>Distribution: {{ market_structure.distribution.dist_risk_composite|default('—') }}</p>
      </section>

      <section class="card" id="regime">
        <h2>Regime engine</h2>
        <p>Current: {{ regime_engine.current_regime|default('N/A') }} · Suggested: {{ regime_engine.suggested_regime|default('N/A') }} · Mismatch: {{ regime_engine.mismatch }}</p>
        <p>Inputs: global_liquidity={{ regime_engine.inputs.global_liquidity|default('—') }}, vn_liquidity={{ regime_engine.inputs.vn_liquidity|default('—') }}</p>
      </section>

      <section class="card" id="decision">
        <h2>Decision layer</h2>
        <p>Rules fired: {{ decision_layer.decision_rules_fired|join(', ')|default('—') }}</p>
        <p>Actions: {{ decision_layer.top_actions|join('; ') }}</p>
        <p>Risks: {{ decision_layer.top_risks|join('; ') }}</p>
      </section>

      <section class="card" id="watchlist">
        <h2>Watchlist</h2>
        <p>Posture: {{ watchlist.posture|default('—') }}</p>
        {% if watchlist.candidates %}
        <table class="data-table">
          <thead><tr><th>Ticker</th><th>Regime fit</th><th>Score</th><th>Notes</th></tr></thead>
          <tbody>
          {% for c in watchlist.candidates %}
          <tr><td>{{ c.ticker }}</td><td>{{ c.regime_fit|default('—') }}</td><td>{{ c.total_score|default('—') }}</td><td>{{ c.notes|default('') }}</td></tr>
          {% endfor %}
          </tbody>
        </table>
        {% else %}
        <p>No candidates listed.</p>
        {% endif %}
      </section>

      <section class="card" id="execution">
        <h2>Execution & sell/trim</h2>
        <p>Risk flag: {{ execution_monitoring.risk_flags.risk_flag|default('—') }}</p>
        {% if execution_monitoring.sell_trim_signals %}
        <table class="data-table col-ticker-action">
          <thead><tr><th class="col-ticker">Ticker</th><th class="col-action">Action</th><th class="col-reason">Reason</th></tr></thead>
          <tbody>
          {% for s in execution_monitoring.sell_trim_signals %}
          <tr><td class="col-ticker">{{ s.ticker }}</td><td class="col-action">{{ s.action|default('—') }}</td><td class="col-reason">{{ s.reason|default('—') }}</td></tr>
          {% endfor %}
          </tbody>
        </table>
        {% else %}
        <p>No sell/trim signals.</p>
        {% endif %}
      </section>

      <section class="card" id="portfolio-health">
        <h2>Portfolio health</h2>
        <p>Summary: {{ portfolio_health.summary|default({}) }}</p>
        {% if portfolio_health.sector_concentration %}
        <table class="data-table">
          <thead><tr><th>Sector</th><th>%</th></tr></thead>
          <tbody>
          {% for row in portfolio_health.sector_concentration %}
          <tr><td>{{ row.sector|default(row.name)|default('—') }}</td><td>{{ row.pct|default(row.percent)|default('—') }}</td></tr>
          {% endfor %}
          </tbody>
        </table>
        {% endif %}
      </section>

      <section class="card" id="geo">
        <h2>Geo layer — Hormuz / energy shock</h2>
        {% if geo_layers and geo_layers.geo_hormuz_energy_shock %}
        {% set gh = geo_layers.geo_hormuz_energy_shock %}
        {% set st = gh.state | default(gh) %}
        <p>Risk state: {{ st.risk_state|default('—') }} · Shock mode: {{ st.shock_mode|default('—') }} · VN inflation: {{ st.inflation_risk_vn|default('—') }} · VN supply: {{ st.supply_disruption_risk_vn|default('—') }}</p>
        {% if st.real_cycle_checklist %}
        <p>Checklist: {{ st.real_cycle_checklist.hits|default(0) }}/{{ st.real_cycle_checklist.total|default(6) }} ({{ st.real_cycle_checklist.classification|default('—') }})</p>
        {% endif %}
        {% else %}
        <p>No geo layer data.</p>
        {% endif %}
      </section>

      <section class="card" id="open">
        <h2>Open questions</h2>
        <ul class="flat">
          {% for q in open_questions %}
          <li>{{ q }}</li>
          {% endfor %}
        </ul>
      </section>

      <section class="card" id="monitoring">
        <h2>Signals to monitor next week</h2>
        <ul class="flat">
          {% for s in monitoring_next_week %}
          <li>{{ s }}</li>
          {% endfor %}
        </ul>
      </section>

      <section class="card" id="playbook">
        <h2>If X happens → do Y</h2>
        <ul class="flat">
          {% for p in playbook_if_x_then_y %}
          <li>{{ p }}</li>
          {% endfor %}
        </ul>
      </section>
    </main>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <script type="application/json" id="viz-data-global-wow">{{ global_macro.what_changed | default([]) | tojson }}</script>
  <script type="application/json" id="viz-data-market-wow">{{ market_structure.what_changed | default([]) | tojson }}</script>
  <script type="application/json" id="viz-data-dist">{{ (execution_monitoring.risk_flags.distribution_days if execution_monitoring.risk_flags else {}) | default({}) | tojson }}</script>
  <script type="application/json" id="viz-data-probs">{{ probability_allocation.probabilities | default({}) | tojson }}</script>
  <script type="application/json" id="viz-data-alloc">{{ probability_allocation.allocation | default({}) | tojson }}</script>
  <script type="application/json" id="viz-data-sectors">{{ portfolio_health.sector_concentration | default([]) | tojson }}</script>

  <script>
  document.addEventListener('DOMContentLoaded', function() {
    if (typeof Chart === 'undefined') return;
    function parseJson(id) {
      var el = document.getElementById(id);
      if (!el || !el.textContent) return null;
      try { return JSON.parse(el.textContent); } catch (e) { return null; }
    }
    var neg = '#b91c1c';
    var pos = '#15803d';
    var neu = '#6b7280';
    function barColor(v) {
      if (v == null || v === '') return neu;
      var n = Number(v);
      if (isNaN(n)) return neu;
      if (n > 0) return pos;
      if (n < 0) return neg;
      return neu;
    }

    var gWow = parseJson('viz-data-global-wow') || [];
    var gLabels = [];
    var gVals = [];
    var gColors = [];
    gWow.forEach(function(row) {
      var m = row.metric || '';
      var v = null;
      if (m === 'UST2Y' || m === 'UST10Y') v = row.delta_bps;
      else if (m === 'DXY') v = row.delta;
      gLabels.push(m);
      gVals.push(v != null ? v : 0);
      gColors.push(barColor(m === 'DXY' ? row.delta : row.delta_bps));
    });
    var ctxG = document.getElementById('chart-global-wow');
    if (ctxG && gLabels.length) {
      new Chart(ctxG, {
        type: 'bar',
        data: { labels: gLabels, datasets: [{ label: 'WoW', data: gVals, backgroundColor: gColors, borderWidth: 0 }] },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: true } }
        }
      });
    }

    var mWow = parseJson('viz-data-market-wow') || [];
    var mLabels = [];
    var mVals = [];
    var mColors = [];
    mWow.forEach(function(row) {
      var m = row.metric || '';
      if (m === 'VNINDEX' || m === 'DIST_DAYS_20') {
        mLabels.push(m);
        var v = row.delta;
        mVals.push(v != null ? v : 0);
        mColors.push(barColor(v));
      }
    });
    var ctxM = document.getElementById('chart-market-wow');
    if (ctxM && mLabels.length) {
      new Chart(ctxM, {
        type: 'bar',
        data: { labels: mLabels, datasets: [{ label: 'WoW', data: mVals, backgroundColor: mColors, borderWidth: 0 }] },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: false } }
        }
      });
    }

    var dist = parseJson('viz-data-dist') || {};
    var dLabels = [];
    var dVals = [];
    if (dist.vn30 != null) { dLabels.push('VN30'); dVals.push(dist.vn30); }
    if (dist.hnx != null) { dLabels.push('HNX'); dVals.push(dist.hnx); }
    if (dist.upcom != null) { dLabels.push('UPCOM'); dVals.push(dist.upcom); }
    var ctxD = document.getElementById('chart-dist-boards');
    if (ctxD && dLabels.length) {
      new Chart(ctxD, {
        type: 'bar',
        data: {
          labels: dLabels,
          datasets: [{ label: 'Dist days', data: dVals, backgroundColor: '#2563eb', borderWidth: 0 }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: { y: { beginAtZero: true, suggestedMax: Math.max.apply(null, dVals.concat([8])) } }
        }
      });
    }

    var probs = parseJson('viz-data-probs') || {};
    var pLabels = ['P(Fed cut 3m)', 'P(VN tighten 1m)', 'P(VNIndex BO 1m)'];
    var pKeys = ['fed_cut_3m', 'vn_tightening_1m', 'vnindex_breakout_1m'];
    var pVals = pKeys.map(function(k) { return probs[k] != null ? probs[k] : 0; });
    var ctxP = document.getElementById('chart-probs');
    if (ctxP && pVals.some(function(x) { return x > 0; })) {
      new Chart(ctxP, {
        type: 'bar',
        data: {
          labels: pLabels,
          datasets: [{ label: 'p', data: pVals, backgroundColor: '#1d4ed8', borderWidth: 0 }]
        },
        options: {
          indexAxis: 'y',
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: { x: { min: 0, max: 1 } }
        }
      });
    }

    var alloc = parseJson('viz-data-alloc') || {};
    var gCap = alloc.gross_exposure_override != null ? alloc.gross_exposure_override : alloc.gross_exposure;
    var cCap = alloc.cash_weight_override != null ? alloc.cash_weight_override : alloc.cash_weight;
    var ctxA = document.getElementById('chart-alloc');
    if (ctxA && gCap != null && cCap != null) {
      new Chart(ctxA, {
        type: 'doughnut',
        data: {
          labels: ['Gross (effective)', 'Cash (effective)'],
          datasets: [{
            data: [Math.round(gCap * 1000) / 1000, Math.round(cCap * 1000) / 1000],
            backgroundColor: ['#2563eb', '#e5e7eb'],
            borderWidth: 1,
            borderColor: '#fff'
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { position: 'bottom' },
            tooltip: {
              callbacks: {
                label: function(ctx) {
                  var v = ctx.raw;
                  return (ctx.label || '') + ': ' + (v * 100).toFixed(1) + '%';
                }
              }
            }
          }
        }
      });
    }

    var sectors = parseJson('viz-data-sectors') || [];
    var sLabels = sectors.map(function(s) { return s.sector || s.name || '—'; });
    var sVals = sectors.map(function(s) { return s.pct != null ? s.pct : s.percent; });
    var ctxS = document.getElementById('chart-sectors');
    if (ctxS && sLabels.length) {
      new Chart(ctxS, {
        type: 'bar',
        data: {
          labels: sLabels,
          datasets: [{ label: '%', data: sVals, backgroundColor: '#374151', borderWidth: 0 }]
        },
        options: {
          indexAxis: 'y',
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: { x: { min: 0, max: 100 } }
        }
      });
    }
  });
  </script>
  <script>
  (function() {
    var navLinks = document.querySelectorAll('.sidebar nav a[href^="#"]');
    var sections = [];
    navLinks.forEach(function(a) {
      var id = a.getAttribute('href').slice(1);
      var el = document.getElementById(id);
      if (el) sections.push({ id: id, el: el, link: a });
    });
    function updateActive() {
      var top = window.pageYOffset || document.documentElement.scrollTop;
      var current = null;
      for (var i = sections.length - 1; i >= 0; i--) {
        var rect = sections[i].el.getBoundingClientRect();
        if (rect.top <= 120) { current = sections[i]; break; }
      }
      if (!current && sections.length) current = sections[0];
      navLinks.forEach(function(a) { a.classList.remove('active'); });
      if (current) current.link.classList.add('active');
    }
    window.addEventListener('scroll', updateActive);
    window.addEventListener('load', updateActive);
  })();
  </script>
</body>
</html>
