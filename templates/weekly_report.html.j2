<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>VN Weekly Report — {{ metadata.asof_date or 'N/A' }}</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap');
    :root {
      --bg: #0d0f12;
      --bg-panel: #13161b;
      --bg-card: #181c22;
      --bg-hover: #1e2330;
      --border: #252a35;
      --border-bright: #2e3545;
      --accent: #00c896;
      --red: #f05050;
      --amber: #f0a030;
      --blue: #4a9eff;
      --text: #d8dde8;
      --text-dim: #7a8399;
      --text-muted: #4a5168;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: "IBM Plex Sans", sans-serif;
      font-size: 14px;
      line-height: 1.65;
    }
    code { font-family: "IBM Plex Mono", monospace; color: var(--text-dim); }
    .mono { font-family: "IBM Plex Mono", monospace; }
    .layout { display: flex; min-height: 100vh; }
    .sidebar {
      width: 200px;
      min-width: 200px;
      position: sticky;
      top: 0;
      height: 100vh;
      overflow-y: auto;
      border-right: 1px solid var(--border);
      background: var(--bg-panel);
      padding: 20px 0;
    }
    .sidebar h3 {
      margin: 14px 18px 8px;
      color: var(--text-muted);
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-family: "IBM Plex Mono", monospace;
    }
    .sidebar a {
      display: block;
      margin: 2px 12px;
      padding: 8px 10px;
      color: var(--text-dim);
      text-decoration: none;
      font-size: 12px;
      border: 1px solid transparent;
      border-radius: 4px;
    }
    .sidebar a:hover { background: var(--bg-hover); color: var(--text); }
    .sidebar a.active {
      background: var(--bg-hover);
      border-color: var(--border-bright);
      color: var(--text);
    }
    .main {
      flex: 1;
      max-width: 1100px;
      padding: 28px 36px;
    }
    .card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 20px;
      margin-bottom: 18px;
    }
    .card-title {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 0 0 14px;
      color: var(--text-dim);
      font-size: 11px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-weight: 600;
    }
    .card-title::after {
      content: "";
      flex: 1;
      height: 1px;
      background: var(--border-bright);
    }
    .header-card {
      border-top: 2px solid var(--accent);
      display: grid;
      grid-template-columns: 1fr 220px;
      gap: 18px;
      align-items: center;
    }
    h1 { margin: 0; font-size: 1.55rem; }
    .subtitle {
      color: var(--text-dim);
      font-size: 12px;
      margin-top: 4px;
      font-family: "IBM Plex Mono", monospace;
    }
    .badge-row { margin-top: 10px; }
    .badge {
      display: inline-block;
      font-size: 10px;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      border-radius: 999px;
      padding: 4px 8px;
      border: 1px solid var(--border);
      margin-right: 6px;
      margin-bottom: 6px;
      font-family: "IBM Plex Mono", monospace;
    }
    .badge-green { color: var(--accent); border-color: rgba(0, 200, 150, 0.25); background: rgba(0, 200, 150, 0.08); }
    .badge-red { color: var(--red); border-color: rgba(240, 80, 80, 0.25); background: rgba(240, 80, 80, 0.08); }
    .badge-amber { color: var(--amber); border-color: rgba(240, 160, 48, 0.25); background: rgba(240, 160, 48, 0.08); }
    .badge-blue { color: var(--blue); border-color: rgba(74, 158, 255, 0.25); background: rgba(74, 158, 255, 0.08); }
    .badge-neutral { color: var(--text-dim); border-color: var(--border); background: var(--bg-panel); }
    .regime-pill {
      border: 1px solid var(--border-bright);
      background: var(--bg-panel);
      border-radius: 6px;
      padding: 12px;
      text-align: center;
    }
    .regime-letter {
      font-family: "IBM Plex Mono", monospace;
      font-size: 1.9rem;
      font-weight: 700;
      color: var(--amber);
      line-height: 1;
    }
    .regime-meta { margin-top: 6px; font-family: "IBM Plex Mono", monospace; color: var(--text-dim); font-size: 11px; }
    .kpi-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
      gap: 10px;
    }
    .kpi {
      position: relative;
      background: var(--bg-panel);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 12px 10px 10px;
      min-height: 82px;
    }
    .kpi::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0;
      width: 100%;
      height: 2px;
      background: var(--border-bright);
      border-radius: 6px 6px 0 0;
    }
    .kpi.up::before { background: var(--accent); }
    .kpi.down::before { background: var(--red); }
    .kpi.warn::before { background: var(--amber); }
    .kpi .label {
      color: var(--text-muted);
      font-size: 9.5px;
      letter-spacing: 0.07em;
      text-transform: uppercase;
    }
    .kpi .value {
      margin-top: 5px;
      color: var(--text);
      font-size: 1.15rem;
      font-weight: 700;
      font-family: "IBM Plex Mono", monospace;
    }
    .kpi.up .value { color: var(--accent); }
    .kpi.down .value { color: var(--red); }
    .kpi-meta { color: var(--text-dim); font-size: 10px; margin-top: 3px; }
    .chip {
      display: inline-block;
      margin: 2px 6px 2px 0;
      padding: 3px 7px;
      border-radius: 999px;
      border: 1px solid var(--border);
      background: var(--bg-panel);
      font-family: "IBM Plex Mono", monospace;
      font-size: 11px;
    }
    .chip .chip-val.pos { color: var(--accent); }
    .chip .chip-val.neg { color: var(--red); }
    .chip .chip-val.neu { color: var(--text-dim); }
    ul { margin: 6px 0; padding-left: 18px; }
    .action-block, .risk-block {
      background: var(--bg-panel);
      border: 1px solid var(--border);
      border-radius: 0 4px 4px 0;
      padding: 10px 12px;
      margin-bottom: 8px;
    }
    .action-block { border-left: 3px solid var(--accent); }
    .risk-block { border-left: 3px solid var(--red); }
    .playbook-item {
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 10px;
      margin-bottom: 8px;
      background: var(--bg-panel);
    }
    .if-label {
      display: inline-block;
      font-family: "IBM Plex Mono", monospace;
      color: var(--amber);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      margin-bottom: 4px;
    }
    table.data-table { width: 100%; border-collapse: collapse; }
    table.data-table th {
      color: var(--text-muted);
      font-size: 10px;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      font-weight: 600;
      border-bottom: 1px solid var(--border-bright);
      padding: 8px 10px;
      text-align: left;
    }
    table.data-table td {
      padding: 8px 10px;
      border-bottom: 1px solid var(--border);
      vertical-align: top;
    }
    table.data-table tbody tr:hover { background: var(--bg-hover); }
    .ticker { font-family: "IBM Plex Mono", monospace; font-weight: 700; color: var(--text); }
    .action-sell { color: var(--red); font-family: "IBM Plex Mono", monospace; font-size: 11px; font-weight: 700; letter-spacing: 0.04em; }
    .action-hold { color: var(--text-dim); font-family: "IBM Plex Mono", monospace; font-size: 11px; font-weight: 600; letter-spacing: 0.04em; }
    .allocation {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 12px;
      align-items: center;
      margin-top: 8px;
    }
    .alloc-bar {
      border: 1px solid var(--border-bright);
      border-radius: 6px;
      overflow: hidden;
      display: flex;
      height: 28px;
      background: var(--bg-panel);
    }
    .alloc-gross { background: var(--blue); }
    .alloc-cash { background: var(--border-bright); }
    .stat-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }
    .stat-box {
      background: var(--bg-panel);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 10px;
    }
    .stat-box .label { color: var(--text-muted); font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; }
    .stat-box .value { margin-top: 6px; color: var(--amber); font-size: 1.4rem; font-family: "IBM Plex Mono", monospace; font-weight: 700; }
    .chart-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
      gap: 12px;
    }
    .chart-card {
      background: var(--bg-panel);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 16px;
    }
    .chart-title {
      margin: 0 0 10px;
      color: var(--text-dim);
      font-family: "IBM Plex Mono", monospace;
      font-size: 10px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .chart-box { position: relative; height: 200px; }
    .meta { color: var(--text-dim); font-size: 12px; }
    @media (max-width: 1100px) {
      .header-card { grid-template-columns: 1fr; }
      .main { padding: 22px; }
      .sidebar { width: 180px; min-width: 180px; }
    }
  </style>
</head>
<body>
{% macro fmt_num(v, decimals=2) -%}
  {%- if v is none -%}—{%- elif v is number -%}
    {%- if v|abs >= 1000 -%}{{ "{:,.1f}".format(v|float) }}{%- else -%}{{ ("{:."+decimals|string+"f}").format(v|float) }}{%- endif -%}
  {%- else -%}{{ v }}{%- endif -%}
{%- endmacro %}
{% macro fmt_pct(v, decimals=2) -%}
  {%- if v is none -%}—{%- else -%}{{ ("{:."+decimals|string+"f}%").format(v|float) }}{%- endif -%}
{%- endmacro %}
{% macro fmt_prob(v, decimals=1) -%}
  {%- if v is none -%}—{%- else -%}{{ ("{:."+decimals|string+"f}%").format((v|float)*100) }}{%- endif -%}
{%- endmacro %}
{% macro fmt_k(v) -%}
  {%- if v is none -%}—{%- else -%}{{ (v|float/1000)|round(0)|int }}k{%- endif -%}
{%- endmacro %}
{% set regime = regime_engine.current_regime|default('N/A') %}
{% set sug = regime_engine.suggested_regime|default('N/A') %}
{% set regime_badge = 'badge-neutral' %}
{% if regime == 'STATE A' %}{% set regime_badge = 'badge-green' %}{% endif %}
{% if regime == 'STATE B' %}{% set regime_badge = 'badge-amber' %}{% endif %}
{% if regime == 'STATE C' %}{% set regime_badge = 'badge-red' %}{% endif %}
{% set risk_flag = (execution_monitoring.risk_flags.risk_flag|default('normal')|lower) %}
{% set risk_badge = 'badge-green' if risk_flag == 'normal' else ('badge-red' if risk_flag == 'high' else 'badge-amber') %}

  <div class="layout">
    <aside class="sidebar">
      <h3>Overview</h3>
      <a href="#header">Header</a>
      <a href="#executive">Executive</a>
      <a href="#kpis">Kpis</a>
      <a href="#visualizations">Visualizations</a>
      <h3>Macro</h3>
      <a href="#global-macro">Global Macro</a>
      <a href="#vn-liquidity">VN Liquidity</a>
      <a href="#market">Market</a>
      <a href="#regime">Regime</a>
      <h3>Portfolio</h3>
      <a href="#decision">Decision</a>
      <a href="#downtrend-v2">Downtrend V2</a>
      <a href="#watchlist">Watchlist</a>
      <a href="#execution">Execution</a>
      <a href="#portfolio-health">Portfolio Health</a>
      <h3>Context</h3>
      <a href="#geo">Geo</a>
      <a href="#open">Open</a>
      <a href="#monitoring">Monitoring</a>
      <a href="#playbook">Playbook</a>
    </aside>
    <main class="main">
      <section class="card header-card" id="header">
        <div>
          <h1>VN Weekly Investment Report</h1>
          <div class="subtitle">ASOF={{ metadata.asof_date or 'N/A' }} · GENERATED={{ metadata.generated_at or 'N/A' }} · SOURCE=PIPELINE</div>
          <div class="badge-row">
            <span class="badge badge-blue">Confidence {{ metadata.data_confidence or 'Low' }}</span>
            <span class="badge {{ regime_badge }}">{{ regime }}</span>
            <span class="badge {{ risk_badge }}">Risk {{ execution_monitoring.risk_flags.risk_flag|default('N/A') }}</span>
            {% if regime_engine.mismatch %}<span class="badge badge-amber">Mismatch</span>{% endif %}
          </div>
        </div>
        <div class="regime-pill">
          <div class="regime-letter">{{ (regime|replace('STATE ', '')|default('N'))[0] }}</div>
          <div class="regime-meta">Current {{ regime }}<br>Suggested {{ sug }}</div>
        </div>
      </section>

      <section class="card" id="executive">
        <h2 class="card-title">Executive</h2>
        <div class="action-block"><strong>Top actions:</strong><ul>{% for a in decision_layer.top_actions|default([]) %}<li>{{ a }}</li>{% endfor %}</ul></div>
        <div class="risk-block"><strong>Top risks:</strong><ul>{% for r in decision_layer.top_risks|default([]) %}<li>{{ r }}</li>{% endfor %}</ul></div>
      </section>

      <section class="card" id="kpis">
        <h2 class="card-title">Kpis</h2>
        <div class="kpi-grid">
          <div class="kpi up"><div class="label">UST 2Y</div><div class="value">{{ fmt_pct(global_macro.facts.ust_2y, 2) }}</div><div class="kpi-meta">{{ global_macro.facts.ust_2y_value_date|default('—') }}</div></div>
          <div class="kpi up"><div class="label">UST 10Y</div><div class="value">{{ fmt_pct(global_macro.facts.ust_10y, 2) }}</div><div class="kpi-meta">{{ global_macro.facts.ust_10y_value_date|default('—') }}</div></div>
          <div class="kpi"><div class="label">DXY Recon</div><div class="value">{{ fmt_num(global_macro.facts.dxy_reconstructed, 2) }}</div><div class="kpi-meta">{{ global_macro.facts.dxy_reconstructed_value_date|default('—') }}</div></div>
          {% if global_macro.facts.dxy_third_party_proxy is not none %}
          <div class="kpi warn"><div class="label">DXY 3rd</div><div class="value">{{ fmt_num(global_macro.facts.dxy_third_party_proxy, 2) }}</div><div class="kpi-meta">{{ global_macro.facts.dxy_third_party_value_date|default('—') }}</div></div>
          {% endif %}
          <div class="kpi"><div class="label">CPI YoY</div><div class="value">{{ fmt_pct(global_macro.facts.cpi_yoy, 2) }}</div><div class="kpi-meta">{{ global_macro.facts.cpi_reference_month|default('—') }}</div></div>
          <div class="kpi"><div class="label">Payroll MoM</div><div class="value">{{ fmt_k(global_macro.facts.nonfarm_payroll_change_persons) }}</div><div class="kpi-meta">persons</div></div>
          <div class="kpi up"><div class="label">VNINDEX</div><div class="value">{{ fmt_num(market_structure.levels.vnindex_level, 1) }}</div></div>
          <div class="kpi"><div class="label">VN30</div><div class="value">{{ fmt_num(market_structure.levels.vn30_level, 1) }}</div></div>
          <div class="kpi up"><div class="label">OMO Net</div><div class="value">{{ fmt_num(vietnam_liquidity.facts.omo_net, 0) }}</div><div class="kpi-meta">{{ vietnam_liquidity.facts.omo_net_verification|default('—') }}</div></div>
          <div class="kpi"><div class="label">Interbank ON</div><div class="value">{{ fmt_pct(vietnam_liquidity.facts.interbank_on, 2) }}</div></div>
          <div class="kpi"><div class="label">SBV USD/VND</div><div class="value">{{ fmt_num(vietnam_liquidity.facts.sbv_reference_usd_vnd|default(vietnam_liquidity.facts.fx_usd_vnd),0) }}</div></div>
          <div class="kpi {% if (market_structure.levels.distribution_days_rolling_20|default(0)|int) > 0 %}warn{% endif %}"><div class="label">Dist Days</div><div class="value">{{ market_structure.levels.distribution_days_rolling_20|default('—') }}</div></div>
        </div>
      </section>

      <section class="card" id="visualizations">
        <h2 class="card-title">Visualizations</h2>
        <div class="chart-grid">
          <div class="chart-card"><p class="chart-title">Global WoW</p><div class="chart-box"><canvas id="chart-global-wow"></canvas></div></div>
          <div class="chart-card"><p class="chart-title">Market WoW</p><div class="chart-box"><canvas id="chart-market-wow"></canvas></div></div>
          <div class="chart-card"><p class="chart-title">Distribution Boards</p><div class="chart-box"><canvas id="chart-dist-boards"></canvas></div></div>
          <div class="chart-card"><p class="chart-title">Scenario Probabilities</p><div class="chart-box"><canvas id="chart-probs"></canvas></div></div>
          <div class="chart-card"><p class="chart-title">Allocation</p><div class="chart-box"><canvas id="chart-alloc"></canvas></div></div>
          <div class="chart-card"><p class="chart-title">Sector Concentration</p><div class="chart-box"><canvas id="chart-sectors"></canvas></div></div>
        </div>
      </section>

      <section class="card" id="global-macro">
        <h2 class="card-title">Global Macro</h2>
        <p class="meta">UST2Y {{ fmt_pct(global_macro.facts.ust_2y,2) }} · UST10Y {{ fmt_pct(global_macro.facts.ust_10y,2) }} · DXY recon {{ fmt_num(global_macro.facts.dxy_reconstructed,2) }} · DXY third {{ fmt_num(global_macro.facts.dxy_third_party_proxy,2) }}</p>
        <p>
          {% for d in global_macro.what_changed|default([]) %}
            {% set dv = d.delta_bps if d.delta_bps is not none else d.delta %}
            {% set dir = d.direction|default('0') %}
            <span class="chip">{{ d.metric }} <span class="chip-val {% if dir == '+' %}pos{% elif dir == '-' %}neg{% else %}neu{% endif %}">
              {% if d.metric == 'DXY' and dv is not none %}{{ "{:.2f}".format(dv|float) }}{% else %}{{ dv|default('—') }}{% endif %}
            </span></span>
          {% endfor %}
        </p>
      </section>

      <section class="card" id="vn-liquidity">
        <h2 class="card-title">VN Liquidity</h2>
        <p>OMO net <span class="mono">{{ fmt_num(vietnam_liquidity.facts.omo_net,0) }}</span> · Interbank ON <span class="mono">{{ fmt_pct(vietnam_liquidity.facts.interbank_on,2) }}</span> · Credit growth <span class="mono">{{ fmt_pct(vietnam_liquidity.facts.credit_growth_yoy,2) }}</span> · SBV USD/VND <span class="mono">{{ fmt_num(vietnam_liquidity.facts.sbv_reference_usd_vnd|default(vietnam_liquidity.facts.fx_usd_vnd),0) }}</span></p>
        {% if vietnam_liquidity.facts.omo_net_source_detail %}<p class="meta">{{ vietnam_liquidity.facts.omo_net_source_detail }}</p>{% endif %}
      </section>

      <section class="card" id="market">
        <h2 class="card-title">Market</h2>
        <p>VNINDEX <span class="mono">{{ fmt_num(market_structure.levels.vnindex_level,1) }}</span> · VN30 <span class="mono">{{ fmt_num(market_structure.levels.vn30_level,1) }}</span> · Dist20 <span class="mono">{{ market_structure.levels.distribution_days_rolling_20|default('—') }}</span> · Composite <span class="badge badge-neutral">{{ market_structure.distribution.dist_risk_composite|default('N/A') }}</span></p>
      </section>

      <section class="card" id="regime">
        <h2 class="card-title">Regime</h2>
        <p><span class="badge {{ regime_badge }}">{{ regime }}</span> Suggested <span class="mono">{{ sug }}</span> {% if regime_engine.mismatch %}<span class="badge badge-amber">Mismatch</span>{% endif %}</p>
      </section>

      <section class="card" id="decision">
        <h2 class="card-title">Decision</h2>
        {% for a in decision_layer.top_actions|default([]) %}<div class="action-block">{{ a }}</div>{% endfor %}
        {% for r in decision_layer.top_risks|default([]) %}<div class="risk-block">{{ r }}</div>{% endfor %}
        {% set alloc = probability_allocation.allocation|default({}) %}
        {% set gross = alloc.gross_exposure_override|default(alloc.gross_exposure)|default(0) %}
        {% set cash = alloc.cash_weight_override|default(alloc.cash_weight)|default(0) %}
        <div class="allocation">
          <div class="alloc-bar"><div class="alloc-gross" style="width: {{ (gross*100)|round(0)|int }}%"></div><div class="alloc-cash" style="width: {{ (cash*100)|round(0)|int }}%"></div></div>
          <div class="mono">{{ (gross*100)|round(0)|int }}% / {{ (cash*100)|round(0)|int }}%</div>
        </div>
      </section>

      <section class="card" id="downtrend-v2">
        <h2 class="card-title">Downtrend V2</h2>
        <div class="stat-grid">
          <div class="stat-box"><div class="label">Outcome B adj</div><div class="value">{{ fmt_prob(downtrend_v2.outcome_b_adjusted, 1) }}</div></div>
          <div class="stat-box"><div class="label">Confirmed adj</div><div class="value">{{ fmt_prob(downtrend_v2.confirmed_downtrend_adjusted, 1) }}</div></div>
        </div>
      </section>

      <section class="card" id="watchlist">
        <h2 class="card-title">Watchlist</h2>
        <table class="data-table">
          <thead><tr><th>Ticker</th><th>Regime fit</th><th>Score</th><th>Notes</th></tr></thead>
          <tbody>
          {% for c in watchlist.candidates|default([]) %}
          <tr><td class="ticker">{{ c.ticker|default('—') }}</td><td>{{ c.regime_fit|default('—') }}</td><td>{{ c.total_score|default('—') }}</td><td>{{ c.notes|default('') }}</td></tr>
          {% endfor %}
          </tbody>
        </table>
      </section>

      <section class="card" id="execution">
        <h2 class="card-title">Execution</h2>
        <table class="data-table">
          <thead><tr><th>Ticker</th><th>Action</th><th>Reason</th></tr></thead>
          <tbody>
          {% for s in execution_monitoring.sell_trim_signals|default([]) %}
          {% set action = s.action|default('—') %}
          <tr>
            <td class="ticker">{{ s.ticker|default('—') }}</td>
            <td>{% if 'SELL' in action or 'EXIT' in action %}<span class="action-sell">{{ action }}</span>{% elif 'HOLD' in action %}<span class="action-hold">{{ action }}</span>{% else %}<span class="action-hold">{{ action }}</span>{% endif %}</td>
            <td>{{ s.reason|default('—') }}</td>
          </tr>
          {% endfor %}
          </tbody>
        </table>
      </section>

      <section class="card" id="portfolio-health">
        <h2 class="card-title">Portfolio Health</h2>
        <div>
          {% for key, value in (portfolio_health.summary|default({})).items() %}
            <span class="chip">{{ key }} <span class="chip-val neu">{{ value }}</span></span>
          {% endfor %}
        </div>
        <table class="data-table">
          <thead><tr><th>Sector</th><th>Weight</th></tr></thead>
          <tbody>
            {% for row in portfolio_health.sector_concentration|default([]) %}
            <tr><td>{{ row.sector|default(row.name)|default('—') }}</td><td>{{ fmt_pct(row.pct|default(row.percent),1) }}</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </section>

      <section class="card" id="geo">
        <h2 class="card-title">Geo</h2>
        {% set gh = geo_layers.geo_hormuz_energy_shock|default({}) %}
        {% set st = gh.state|default(gh) %}
        <p><span class="badge badge-blue">{{ st.risk_state|default('N/A') }}</span> Mode {{ st.shock_mode|default('—') }} · Inflation {{ st.inflation_risk_vn|default('—') }} · Supply {{ st.supply_disruption_risk_vn|default('—') }}</p>
      </section>

      <section class="card" id="open">
        <h2 class="card-title">Open</h2>
        <ul>{% for q in open_questions|default([]) %}<li>{{ q }}</li>{% endfor %}</ul>
      </section>

      <section class="card" id="monitoring">
        <h2 class="card-title">Monitoring</h2>
        <ul>{% for s in monitoring_next_week|default([]) %}<li>{{ s }}</li>{% endfor %}</ul>
      </section>

      <section class="card" id="playbook">
        <h2 class="card-title">Playbook</h2>
        {% for p in playbook_if_x_then_y|default([]) %}
          <div class="playbook-item">
            <div class="if-label">If / Then</div>
            <div>{{ p }}</div>
          </div>
        {% endfor %}
      </section>
    </main>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <script type="application/json" id="viz-data-global-wow">{{ global_macro.what_changed | default([]) | tojson }}</script>
  <script type="application/json" id="viz-data-market-wow">{{ market_structure.what_changed | default([]) | tojson }}</script>
  <script type="application/json" id="viz-data-dist">{{ (execution_monitoring.risk_flags.distribution_days if execution_monitoring.risk_flags else {}) | default({}) | tojson }}</script>
  <script type="application/json" id="viz-data-probs">{{ probability_allocation.probabilities | default({}) | tojson }}</script>
  <script type="application/json" id="viz-data-alloc">{{ probability_allocation.allocation | default({}) | tojson }}</script>
  <script type="application/json" id="viz-data-sectors">{{ portfolio_health.sector_concentration | default([]) | tojson }}</script>
  <script>
  document.addEventListener('DOMContentLoaded', function() {
    if (typeof Chart === 'undefined') return;
    Chart.defaults.color = '#7a8399';
    Chart.defaults.borderColor = '#252a35';
    Chart.defaults.font.family = "'IBM Plex Mono', monospace";
    Chart.defaults.font.size = 10;
    function parseJson(id){var el=document.getElementById(id);if(!el||!el.textContent)return null;try{return JSON.parse(el.textContent);}catch(_){return null;}}
    const ACCENT='#00c896', RED='#f05050', BLUE='#4a9eff', DIM='#7a8399';
    const barColor = (v)=> v>0?ACCENT:(v<0?RED:BLUE);
    const gWow=parseJson('viz-data-global-wow')||[];
    const gLabels=[],gVals=[],gColors=[];
    gWow.forEach(r=>{const m=r.metric||''; const v=(m==='UST2Y'||m==='UST10Y')?r.delta_bps:r.delta; gLabels.push(m); gVals.push(v??0); gColors.push(barColor(v??0));});
    if(document.getElementById('chart-global-wow')&&gLabels.length){new Chart(document.getElementById('chart-global-wow'),{type:'bar',data:{labels:gLabels,datasets:[{data:gVals,backgroundColor:gColors,borderWidth:0}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}}}});}
    const mWow=parseJson('viz-data-market-wow')||[];
    const mLabels=[],mVals=[],mColors=[];
    mWow.forEach(r=>{if(r.metric==='VNINDEX'||r.metric==='DIST_DAYS_20'){mLabels.push(r.metric);mVals.push(r.delta??0);mColors.push(barColor(r.delta??0));}});
    if(document.getElementById('chart-market-wow')&&mLabels.length){new Chart(document.getElementById('chart-market-wow'),{type:'bar',data:{labels:mLabels,datasets:[{data:mVals,backgroundColor:mColors,borderWidth:0}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}}}});}
    const dist=parseJson('viz-data-dist')||{}; const dLabels=[],dVals=[]; ['vn30','hnx','upcom'].forEach(k=>{if(dist[k]!=null){dLabels.push(k.toUpperCase());dVals.push(dist[k]);}});
    if(document.getElementById('chart-dist-boards')&&dLabels.length){new Chart(document.getElementById('chart-dist-boards'),{type:'bar',data:{labels:dLabels,datasets:[{data:dVals,backgroundColor:BLUE,borderWidth:0}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{beginAtZero:true}}}});}
    const probs=parseJson('viz-data-probs')||{}; const pLabels=['Fed cut 3m','VN tighten 1m','VNIndex BO 1m']; const pVals=[probs.fed_cut_3m??0,probs.vn_tightening_1m??0,probs.vnindex_breakout_1m??0];
    if(document.getElementById('chart-probs')){new Chart(document.getElementById('chart-probs'),{type:'bar',data:{labels:pLabels,datasets:[{data:pVals,backgroundColor:BLUE,borderWidth:0}]},options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{min:0,max:1}}}});}
    const alloc=parseJson('viz-data-alloc')||{}; const gross=(alloc.gross_exposure_override??alloc.gross_exposure); const cash=(alloc.cash_weight_override??alloc.cash_weight);
    if(document.getElementById('chart-alloc')&&gross!=null&&cash!=null){new Chart(document.getElementById('chart-alloc'),{type:'doughnut',data:{labels:['Gross','Cash'],datasets:[{data:[gross,cash],backgroundColor:[BLUE,'#2e3545'],borderWidth:0}]},options:{responsive:true,maintainAspectRatio:false,cutout:'65%',plugins:{legend:{position:'bottom'}}}});}
    const sectors=parseJson('viz-data-sectors')||[]; const sLabels=sectors.map(s=>s.sector||s.name||'—'); const sVals=sectors.map(s=>s.pct??s.percent??0);
    if(document.getElementById('chart-sectors')&&sLabels.length){new Chart(document.getElementById('chart-sectors'),{type:'bar',data:{labels:sLabels,datasets:[{data:sVals,backgroundColor:DIM,borderWidth:0}]},options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{x:{min:0,max:100}}}});}
  });
  (function(){const links=document.querySelectorAll('.sidebar a[href^="#"]');const sections=[];links.forEach(a=>{const id=a.getAttribute('href').slice(1),el=document.getElementById(id);if(el)sections.push({el,link:a});});function update(){let current=null;for(let i=sections.length-1;i>=0;i--){if(sections[i].el.getBoundingClientRect().top<=120){current=sections[i];break;}}if(!current&&sections.length)current=sections[0];links.forEach(a=>a.classList.remove('active'));if(current)current.link.classList.add('active');}window.addEventListener('scroll',update);window.addEventListener('load',update);})();
  </script>
</body>
</html>
