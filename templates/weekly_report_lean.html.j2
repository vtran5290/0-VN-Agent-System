<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>VN Weekly Report — {{ metadata.asof_date or 'N/A' }}</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap');
    :root { --bg:#0d0f12; --panel:#13161b; --card:#181c22; --border:#252a35; --accent:#00c896; --red:#f05050; --amber:#f0a030; --blue:#4a9eff; --text:#d8dde8; --dim:#7a8399; --muted:#4a5168; }
    *{box-sizing:border-box} body{margin:0;background:var(--bg);color:var(--text);font-family:"IBM Plex Sans",sans-serif;font-size:14px;line-height:1.6}
    .layout{display:flex;min-height:100vh} .sidebar{width:190px;position:sticky;top:0;height:100vh;overflow-y:auto;border-right:1px solid var(--border);background:var(--panel);padding:16px 0}
    .sidebar a{display:block;margin:2px 10px;padding:7px 9px;color:var(--dim);text-decoration:none;font-size:11px;border-radius:4px}
    .sidebar a:hover,.sidebar a.active{background:#1e2330;color:var(--text)} .sidebar h3{margin:12px 14px 6px;font-size:9px;color:var(--muted);text-transform:uppercase;letter-spacing:.08em}
    .main{flex:1;max-width:1080px;padding:24px 32px} .card{background:var(--card);border:1px solid var(--border);border-radius:6px;padding:18px;margin-bottom:14px;overflow:visible}
    .card-title{margin:0 0 12px;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--dim);font-weight:600}
    .card-priority{border-left:3px solid var(--red)} .card-warn{border-left:3px solid var(--amber)} .card-ok{border-left:3px solid var(--accent)}
    .mono{font-family:"IBM Plex Mono",monospace} .meta{color:var(--dim);font-size:12px} .warn-banner{background:rgba(240,160,48,.1);border:1px solid rgba(240,160,48,.35);color:var(--amber);padding:8px 10px;border-radius:6px;margin-bottom:10px;font-size:12px}
    .warn-banner.dq-crit{background:rgba(240,80,80,.12);border:1px solid rgba(240,80,80,.45);color:var(--red);font-weight:600}
    .dq-strip{font-size:12px;padding:8px 12px;border-radius:6px;background:var(--panel);border:1px solid var(--border)} .dq-good{color:var(--accent)} .dq-warn{color:var(--amber)} .dq-crit{color:var(--red)}
    .cmd-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:8px} .cmd-item{background:var(--panel);border:1px solid var(--border);border-radius:6px;padding:9px}
    .cmd-item .label{color:var(--muted);font-size:9px;text-transform:uppercase} .cmd-item .value{margin-top:3px;font-family:"IBM Plex Mono",monospace;font-size:12px}
    .cmd-item.forced .value{color:var(--red);font-weight:700} .kpi-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:8px}
    .kpi{background:var(--panel);border:1px solid var(--border);border-radius:6px;padding:10px} .kpi .label{font-size:9px;color:var(--muted);text-transform:uppercase} .kpi .value{font-family:"IBM Plex Mono",monospace;font-size:13px;margin-top:4px}
    .data-table{width:100%;border-collapse:collapse;font-size:12px} .data-table th,.data-table td{border-bottom:1px solid var(--border);padding:6px 8px;text-align:left;vertical-align:top}
    .data-table th{color:var(--muted);font-size:10px;text-transform:uppercase} .ticker{font-weight:600;color:var(--accent)} .action-sell{color:var(--red);font-weight:700} .action-hold{color:var(--dim)}
    .table-scroll{width:100%;max-width:100%;overflow-x:auto;overflow-y:visible;-webkit-overflow-scrolling:touch;margin:0 -4px;padding:0 4px 6px}
    .table-scroll .data-table--wide{width:max-content;min-width:100%;table-layout:auto}
    .table-scroll .data-table--wide th,.table-scroll .data-table--wide td{white-space:nowrap}
    .table-scroll .data-table--wide .col-reason{white-space:normal;min-width:11rem;max-width:16rem}
    .table-scroll .data-table--wide .col-action{white-space:normal;min-width:9.5rem;max-width:12rem}
    .table-scroll-hint{font-size:10px;color:var(--muted);margin:0 0 8px;text-align:right}
    .health-verdict{font-size:15px;font-weight:600;margin-bottom:10px} .chart-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px} .chart-card{background:var(--panel);border:1px solid var(--border);border-radius:6px;padding:10px}
    .chart-box{height:160px} .interp{font-size:11px;color:var(--dim);margin-top:6px} h1{margin:0;font-size:1.4rem} .badge{display:inline-block;font-size:9px;padding:3px 8px;border-radius:4px;margin-right:6px}
    .badge-amber{background:rgba(240,160,48,.15);color:var(--amber)} .badge-green{background:rgba(0,200,150,.12);color:var(--accent)} .badge-red{background:rgba(240,80,80,.12);color:var(--red)}
    tr.row-mismatch{background:rgba(240,80,80,.08)} tr.row-noscan{background:rgba(240,160,48,.1)} .appendix{opacity:.92;font-size:13px}
    .badge-noscan{font-size:9px;color:var(--amber);margin-left:4px}
    .ctx-tag{display:inline-block;background:#0f1e2e;color:#6a9cc8;border:1px solid #1e3650;border-radius:3px;padding:0 6px;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;margin-left:6px;vertical-align:middle}
    .ssot-tag{display:inline-block;background:#0f2010;color:var(--accent);border:1px solid #1e4020;border-radius:3px;padding:0 6px;font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;margin-left:6px;vertical-align:middle}
    .ctx-safety{background:#0c1825;border-left:3px solid #2a5080;border-radius:0 4px 4px 0;padding:8px 10px;margin:0 0 10px;font-size:12px;color:#7aa8d0}
    .exec-summary table.data-table{margin-top:8px}
    .nav-inline{display:flex;flex-wrap:wrap;gap:6px;margin:10px 0 14px;font-size:11px}
    .nav-inline a{color:var(--dim);text-decoration:none;padding:4px 8px;border:1px solid var(--border);border-radius:4px}
    .nav-inline a:hover{color:var(--text);background:#1e2330}
  </style>
</head>
<body>
<div class="layout">
<aside class="sidebar">
  <h3>Command</h3>
  <a href="#header">Header</a>
  <a href="#executive-summary">30-Second Summary</a>
  <a href="#command-center">Command Center</a>
  <a href="#market-pulse">Market Pulse</a>
  <a href="#portfolio-summary">Portfolio Summary</a>
  <a href="#execution">Execution</a>
  <a href="#watchlist">Watchlist</a>
  <h3>Context</h3>
  <a href="#rs-c3-context">RS C3</a>
  <a href="#smart-kpi">Smart KPI</a>
  <a href="#visualizations">Charts</a>
  <a href="#decision">Decision Plan</a>
  <a href="#decision-review">Decision Review</a>
  <a href="#appendix">Appendix</a>
</aside>
<main class="main">

{% set pcc = portfolio_command_center|default({}) %}
{% set dq = data_quality_compact|default({}) %}
<section class="card header-card" id="header">
  <h1>VN Weekly Investment Report</h1>
  <p class="meta mono">ASOF {{ metadata.asof_date or 'N/A' }} · {{ metadata.data_confidence or 'Low' }} confidence{% if metadata.warnings %} · ⚠ see warnings{% endif %} · B_cloud20_100 / A3_PRODUCTION</p>
  <div class="dq-strip {% if dq.status == 'Good' %}dq-good{% elif dq.status == 'Critical' %}dq-crit{% else %}dq-warn{% endif %}">{{ dq.strip|default('Data quality unknown') }}</div>
  {% if metadata.warnings %}
  <div class="warn-banner" style="margin-top:8px">
    <strong>⚠ Report warnings:</strong>
    <ul style="margin:4px 0 0 0;padding-left:18px">{% for w in metadata.warnings %}<li>{{ w }}</li>{% endfor %}</ul>
  </div>
  {% endif %}
  <nav class="nav-inline" aria-label="Report sections">
    <a href="#executive-summary">Summary</a>
    <a href="#command-center">Command</a>
    <a href="#market-pulse">Market</a>
    <a href="#execution">Execution</a>
    <a href="#watchlist">Watchlist</a>
    <a href="#rs-c3-context">RS C3</a>
    <a href="#smart-kpi">KPI</a>
    <a href="#appendix">Appendix</a>
  </nav>
</section>

<section class="card exec-summary" id="executive-summary">
  <h2 class="card-title">30-Second Executive Summary</h2>
  <table class="data-table">
    <thead><tr><th>Metric</th><th>Value</th></tr></thead>
    <tbody>
      <tr><td>Regime</td><td class="mono"><strong>{{ pcc.current_regime|default('—') }}</strong> · {{ pcc.regime_confidence|default('—') }}</td></tr>
      <tr><td>Gross exposure</td><td class="mono">{% if pcc.gross_exposure_current is not none %}{{ (pcc.gross_exposure_current*100)|round(0)|int }}%{% else %}—{% endif %} (target {{ pcc.gross_exposure_target_band|default('—') }})</td></tr>
      <tr><td>New buy mode</td><td><strong>{{ pcc.new_buy_mode|default('—') }}</strong></td></tr>
      <tr><td>Priority action</td><td>{{ pcc.highest_priority_action|default('—') }}</td></tr>
      <tr><td>Forced exits</td><td class="mono">{{ pcc.forced_exit_count|default(0) }}</td></tr>
      <tr><td>Data quality</td><td>{{ pcc.data_quality_status|default('—') }}</td></tr>
    </tbody>
  </table>
  <div class="ctx-safety" style="margin-top:10px">
    <strong>SSOT reminder:</strong> Production actions use <code>final_action</code> from the Phase36 scan only.
    Distribution Risk, RS Correction, and research lenses are <strong>context only</strong> — they do not set or override <code>final_action</code>.
  </div>
</section>

{% include "weekly_report_portfolio_blocks.j2" %}

<section class="card" id="market-pulse">
  <h2 class="card-title">{{ market_pulse.title|default('What Changed / Market Pulse') }} <span class="ctx-tag">MARKET CONTEXT</span></h2>
  <div class="ctx-safety">Market Pulse is context for regime and risk framing. It does <strong>not</strong> set or override <code>final_action</code>.</div>
  {% if market_pulse.warning %}<div class="warn-banner">{{ market_pulse.warning }}</div>{% endif %}
  <table class="data-table">
    <thead><tr><th>Metric</th><th>Current</th><th>Δ 1W</th><th>Dir</th><th>Signal</th><th>Portfolio implication</th></tr></thead>
    <tbody>{% for r in market_pulse.rows|default([]) %}
    {# FIX2: credit_growth_yoy is stored as ratio (1.0) but pre-formatted as "100.0%" in JSON; display raw ratio as pct string, keep delta on same scale #}
    {# FIX6c: DXY level 135.0 is a proxy — append suspect note #}
    {% set _mp_current = r.current %}
    {% set _mp_delta = r.delta_1w %}
    {% if r.metric_id == 'CREDIT_GROWTH' %}
      {# raw value is 1.0 (ratio); pre-formatted current is "100.0%" (wrong ×100); re-emit as "1.0%" — verify if input is ratio vs percent #}
      {% set _mp_current = "1.0% (verify if input is ratio vs percent)" %}
      {# delta is "-11.10 pp" — keep as-is (same pp scale as ratio pct) #}
    {% endif %}
    {% if r.metric_id == 'DXY' %}
      {% set _mp_current = r.current ~ " [SUSPECT — proxy; last reconstructed 98.1]" %}
    {% endif %}
    <tr><td>{{ r.metric }}</td><td class="mono">{{ _mp_current }}</td><td class="mono">{{ _mp_delta }}</td><td>{{ r.direction }}</td><td>{{ r.signal }}</td><td>{{ r.portfolio_implication }}</td></tr>
    {% endfor %}</tbody>
  </table>
</section>

<section class="card" id="portfolio-summary">
  <h2 class="card-title">Portfolio Summary & Health</h2>
  {% set ps = portfolio_summary|default({}) %}
  <p class="health-verdict">{{ ps.summary_line|default('—') }}</p>
  <div class="kpi-grid">
    <div class="kpi"><div class="label">Positions</div><div class="value">{{ ps.n_positions|default('Missing') }}</div></div>
    <div class="kpi"><div class="label">Gross</div><div class="value">{% if ps.gross_exposure is not none %}{{ fmt_pct(ps.gross_exposure) }}{% else %}Missing{% endif %}</div></div>
    <div class="kpi"><div class="label">Cash</div><div class="value">{% if ps.cash is not none %}{{ fmt_pct(ps.cash) }}{% else %}Missing{% endif %}</div></div>
    <div class="kpi"><div class="label">Largest wt</div><div class="value">{{ ps.largest_position_weight_pct|default('Missing') }}{% if ps.largest_position_weight_pct and ps.largest_position_weight_pct != 'Missing' %}%{% endif %}</div></div>
    <div class="kpi warn"><div class="label">Portfolio forced exits</div><div class="value">{{ ps.forced_exit_count|default(0) }}</div></div>
    <div class="kpi"><div class="label">Universe forced exits</div><div class="value">{{ ps.universe_forced_exit_count|default('Missing') }}</div></div>
    <div class="kpi warn"><div class="label">Near trail/stop</div><div class="value">{% if ps.near_trail_count is not none %}{{ ps.near_trail_count }}{% if ps.near_trail_pct is not none %} ({{ ps.near_trail_pct|int }}%){% endif %}{% else %}Missing{% endif %}</div></div>
    <div class="kpi"><div class="label">A3 positions</div><div class="value">{{ ps.a3_production_positions|default('Missing') }}</div></div>
  </div>
  {# FIX6a: dedupe warnings — only show each unique warning once #}
  {% set _seen_warnings = [] %}
  {% for w in ps.warnings|default([]) %}{% if w not in _seen_warnings %}<div class="warn-banner">{{ w }}</div>{% set _ = _seen_warnings.append(w) %}{% endif %}{% endfor %}
  <table class="data-table"><thead><tr><th>Sector</th><th>Count</th><th>Wt%</th><th>Status</th></tr></thead>
  <tbody>{% for row in ps.sector_rows|default([]) %}<tr><td>{{ row.sector }}</td><td>{{ row.position_count }}</td><td>{{ row.weight_pct }}%</td><td>{{ row.status }}</td></tr>{% endfor %}</tbody></table>
</section>

<section class="card {% if position_decisions.mismatch_count %}card-priority{% endif %}" id="execution">
  <h2 class="card-title">Execution / Position Actions <span class="ssot-tag">ACTION SSOT: final_action</span></h2>
  <p class="meta">Phase36 scan · strategy B_cloud20_100 · {{ position_decisions.scan_source|default('scan Missing') }}</p>
  {% if position_decisions.warning %}<div class="warn-banner">{{ position_decisions.warning }}</div>{% endif %}
  {% if position_decisions.mismatch_warning %}<div class="warn-banner dq-crit">{{ position_decisions.mismatch_warning }}</div>{% endif %}
  <p class="table-scroll-hint">Wide table — scroll horizontally → Required action</p>
  <div class="table-scroll"><table class="data-table data-table--wide">
  <thead><tr><th>Ticker</th><th>Book</th><th>Sector</th><th>Wt%</th><th>Scan action</th><th class="col-reason">Scan reason</th><th>Operator</th><th>Report</th><th>Cloud</th><th>Trail</th><th>TP1</th><th>Dist trail</th><th class="col-action">Required action</th></tr></thead>
  <tbody>{% for s in position_decisions.rows|default([]) %}
  {# FIX4: if scan_missing=true but scan_gap_kind='research_only', symbol IS in scan as SKIP — show actual SKIP action instead of "Missing" + "No scan" badge #}
  {# scan_reason format: "In scan as SKIP (SKIP_VNINDEX_BEAR) — excluded from A3_PRODUCTION production book" #}
  {# Use namespace to allow mutation inside inner if blocks (Jinja2 scope workaround) #}
  {% set ns4 = namespace(scan_action=s.scan_final_action|default('Missing'), show_noscan=s.scan_missing) %}
  {% if s.scan_missing and s.scan_gap_kind == 'research_only' and s.scan_reason %}
    {% if 'In scan as SKIP' in s.scan_reason and '(' in s.scan_reason and ')' in s.scan_reason %}
      {% set _after_open = s.scan_reason.split('(')[1] %}
      {% set ns4.scan_action = _after_open.split(')')[0] %}
      {% set ns4.show_noscan = false %}
    {% elif 'In scan as SKIP' in s.scan_reason %}
      {% set ns4.scan_action = 'SKIP (see reason)' %}
      {% set ns4.show_noscan = false %}
    {% endif %}
  {% endif %}
  {# FIX3: trail_price unit mismatch — if trail > 1000 × current_price, divide by 1000 (upstream stores trail in VND, close in kVND) #}
  {# Upstream unit inconsistency: stop_price/trail in raw VND (e.g. 13,596,000) vs close in kVND (e.g. 14,200) — normalize at render time #}
  {% set ns3 = namespace(trail=s.trail_price, dist=s.distance_to_trail_pct|default('Missing')) %}
  {% if s.trail_price and s.trail_price != 'Missing' and s.current_price %}
    {% set _trail_num = s.trail_price | replace(',', '') | float(-1) %}
    {% set _close_num = s.current_price | float(-1) %}
    {% if _trail_num > 0 and _close_num > 0 and _trail_num > _close_num * 100 %}
      {# trail is in raw VND, close is in kVND — divide trail by 1000 and recompute dist-trail % (ratio >100x detected) #}
      {% set _trail_norm = (_trail_num / 1000) %}
      {% set ns3.trail = '%.2f'|format(_trail_norm) ~ ' (÷1000 unit fix)' %}
      {% set ns3.dist = '%.1f'|format((_close_num - _trail_norm) / _trail_norm * 100) ~ '%' %}
    {% endif %}
  {% endif %}
  <tr{% if s.row_class %} class="{{ s.row_class }}"{% elif s.action_mismatch %} class="row-mismatch"{% endif %}>
    <td class="ticker">{{ s.ticker }}</td><td>{{ s.strategy_book|default('—') }}</td><td>{{ s.sector }}</td><td class="mono">{{ s.weight_pct|default('Missing') }}{% if s.weight_pct and s.weight_pct != 'Missing' %}%{% endif %}</td>
    <td class="mono">{{ ns4.scan_action }}{% if ns4.show_noscan %}<span class="badge-noscan">Not in scan</span>{% endif %}</td>
    <td class="col-reason" title="{{ s.scan_reason|default('') }}">{{ s.scan_reason|default('—') }}</td>
    <td>{{ s.operator_action|default('—') }}</td>
    <td>{{ s.report_action|default('—') }}</td><td>{{ s.cloud_status|default('Missing') }}</td>
    <td class="mono">{{ ns3.trail }}</td><td class="mono">{{ s.tp1_price }}</td>
    <td>{{ ns3.dist }}</td>
    <td class="col-action">{% if 'EXIT' in (s.required_operator_action|default('')|upper) or 'SELL' in (s.required_operator_action|default('')|upper) %}<span class="action-sell">{{ s.required_operator_action }}</span>{% else %}<span class="action-hold">{{ s.required_operator_action|default('—') }}</span>{% endif %}</td>
  </tr>{% endfor %}</tbody></table></div>
</section>

<section class="card" id="watchlist">
  <h2 class="card-title">Watchlist / Next Buy ({{ watchlist_board.filter|default('A3_PRODUCTION') }}) <span class="ssot-tag">ACTION SSOT: final_action</span></h2>
  {% if watchlist_board.note %}<div class="warn-banner">{{ watchlist_board.note }}</div>{% endif %}
  <p class="meta">{{ watchlist_board.scan_source|default('') }} · a3_rank_score = review sort only</p>
  <div class="table-scroll"><table class="data-table">
  <thead><tr><th>Ticker</th><th>Bucket</th><th>final_action</th><th>Cloud</th><th>Breadth</th><th>Score</th><th>Trigger</th></tr></thead>
  <tbody>{% for c in watchlist_board.candidates|default([]) %}
  <tr><td class="ticker">{{ c.ticker }}</td><td>{{ c.bucket }}</td><td>{{ c.final_action }}</td><td>{{ c.a3_cloud_bull|default('—') }}</td><td>{{ c.breadth_zone|default('—') }}</td><td>{{ c.a3_rank_score|default('—') }}</td><td class="mono">{{ c.trigger_price|default('—') }}</td></tr>
  {% endfor %}</tbody></table></div>
</section>

{% if rs_c3_html %}
<section class="card" id="rs-c3-context">
  <h2 class="card-title">RS C3 Context (RS line acceleration) <span class="ctx-tag">REVIEW RANKING ONLY</span></h2>
  <div class="ctx-safety">RS C3 does <strong>not</strong> set or override <code>final_action</code>. IC near zero in OOS3 2024+. Top LEADER/OUTPERFORM from scan universe shown.</div>
  {{ rs_c3_html | safe }}
</section>
{% endif %}

<section class="card" id="smart-kpi">
  <h2 class="card-title">Smart KPI Board <span class="ctx-tag">MARKET CONTEXT</span></h2>
  <div class="ctx-safety">KPI board = levels and interpretation. WoW deltas and index moves live in <a href="#market-pulse" style="color:#7aa8d0">Market Pulse</a> only — do not treat KPI duplicates as a second SSOT.</div>
  <p class="meta">{{ smart_kpi_board.note|default('') }}</p>
  <h3 class="card-title">Global Drivers (levels)</h3>
  <div class="kpi-grid">{% for k in smart_kpi_board.global_drivers|default([]) %}
  {# FIX6c: DXY level 135.0 is a proxy/reconstructed value — append suspect note #}
  {% if k.label == 'DXY' %}
  <div class="kpi"><div class="label">{{ k.label }}</div><div class="value">{{ k.value }} [SUSPECT — proxy; last reconstructed 98.1]</div><div class="meta">{{ k.meta }}</div></div>
  {% else %}
  <div class="kpi"><div class="label">{{ k.label }}</div><div class="value">{{ k.value }}</div><div class="meta">{{ k.meta }}</div></div>
  {% endif %}
  {% endfor %}</div>
  <h3 class="card-title">Vietnam Liquidity & Policy</h3>
  <div class="kpi-grid">{% for k in smart_kpi_board.vn_liquidity|default([]) %}
  {# FIX2: Credit growth KPI: raw value 1.0 pre-formatted as "100.0%" — display as "1.0%" (verify if input is ratio vs percent) #}
  {% if k.label == 'Credit growth YoY' %}
  <div class="kpi"><div class="label">{{ k.label }}</div><div class="value">1.0%</div><div class="meta">{{ k.meta }} · verify if input is ratio vs percent</div></div>
  {% else %}
  <div class="kpi"><div class="label">{{ k.label }}</div><div class="value">{{ k.value }}</div><div class="meta">{{ k.meta }}</div></div>
  {% endif %}
  {% endfor %}</div>
  <h3 class="card-title">Market Internals</h3>
  <div class="kpi-grid">{% for k in smart_kpi_board.market_internals|default([]) %}<div class="kpi"><div class="label">{{ k.label }}</div><div class="value">{{ k.value }}</div><div class="meta">{{ k.meta }}</div></div>{% endfor %}</div>
  <h3 class="card-title">Global Macro (implications)</h3>
  {# FIX6b: only render <ul> if facts list is non-empty #}
  <p><strong>Facts:</strong></p>{% if global_macro_narrative.facts|default([]) %}<ul>{% for f in global_macro_narrative.facts|default([]) %}<li>{{ f }}</li>{% endfor %}</ul>{% endif %}
  <p><strong>Interpretation:</strong> {{ global_macro_narrative.interpretation|default('—') }}</p>
  <p><strong>Portfolio implication:</strong> {{ global_macro_narrative.portfolio_implication|default('—') }}</p>
  <h3 class="card-title">VN Liquidity (implications)</h3>
  <p><strong>Signal:</strong> {{ vn_liquidity_narrative.signal|default('—') }}</p>
  {# FIX6b: only render <ul> if facts list is non-empty #}
  {% if vn_liquidity_narrative.facts|default([]) %}<ul>{% for f in vn_liquidity_narrative.facts|default([]) %}<li>{{ f }}</li>{% endfor %}</ul>{% endif %}
  <p>{{ vn_liquidity_narrative.interpretation|default('') }} → {{ vn_liquidity_narrative.portfolio_implication|default('') }}</p>
</section>

<section class="card" id="visualizations">
  <h2 class="card-title">Smart Visualizations</h2>
  <div class="chart-grid">
  {% for ch in visualizations_smart.charts|default([]) %}
  <div class="chart-card">
    <p class="card-title">{{ ch.title }}</p>
    <div class="chart-box"><canvas id="chart-{{ ch.id }}"></canvas></div>
    <p class="interp">{{ ch.interpretation }}</p>
  </div>
  {% endfor %}
  </div>
</section>

<section class="card" id="decision">
  <h2 class="card-title">Decision Plan</h2>
  <p class="meta"><strong>Weekly stance:</strong> {{ decision_layer.weekly_stance|default('—') }}</p>
  <h3 class="card-title">A. Immediate Actions</h3><ul>{% for a in decision_layer.immediate_actions|default([]) %}<li>{{ a }}</li>{% endfor %}</ul>
  <h3 class="card-title">B. Conditional Actions</h3><ul>{% for a in decision_layer.conditional_actions|default([]) %}<li>{{ a }}</li>{% endfor %}</ul>
  <h3 class="card-title">C. Do-Not-Do</h3><ul>{% for a in decision_layer.do_not_do|default([]) %}<li>{{ a }}</li>{% endfor %}</ul>
</section>

<section class="card" id="decision-review">
  <h2 class="card-title">Decision Review</h2>
  {% if decision_review.note %}<p class="meta">{{ decision_review.note }}</p>{% endif %}
  <table class="data-table"><thead><tr><th>Decision</th><th>Expected</th><th>Lesson</th></tr></thead>
  <tbody>{% for r in decision_review.rows|default([]) %}<tr><td>{{ r.last_week_decision|default('—') }}</td><td>{{ r.expected_outcome|default('—') }}</td><td>{{ r.lesson|default('—') }}</td></tr>{% endfor %}</tbody></table>
</section>

<section class="card appendix" id="appendix">
  <h2 class="card-title">Appendix <span class="ctx-tag" style="opacity:.7">DETAIL TABLES</span></h2>
  <p class="meta">Full regime rules, data freshness, monitoring playbook — reference only.</p>
  <h3>Regime rules (full table)</h3>
  <table class="data-table"><thead><tr><th>Regime</th><th>Band</th><th>New buys</th><th>Adds</th><th>Trims</th></tr></thead>
  <tbody>{% for r in regime_rules.rows|default([]) %}<tr {% if r.is_current %}style="background:rgba(0,200,150,.06)"{% endif %}><td>{{ r.regime }}</td><td>{{ r.gross_band }}</td><td>{{ r.new_buys }}</td><td>{{ r.adds }}</td><td>{{ r.trims }}</td></tr>{% endfor %}</tbody></table>
  <h3>Data freshness (full)</h3>
  <table class="data-table"><thead><tr><th>Block</th><th>Updated</th><th>Status</th></tr></thead>
  <tbody>{% for f in data_quality_compact.full_table|default(data_freshness)|default([]) %}<tr><td>{{ f.block|default('—') }}</td><td>{% if f.last_updated is not none %}{{ f.last_updated }}{% else %}Missing{% endif %}</td><td>{{ f.freshness|default(f.status)|default('—') }}</td></tr>{% endfor %}</tbody></table>
  <h3>Monitoring (next week)</h3><ul>{% for s in monitoring_next_week|default([]) %}<li>{{ s }}</li>{% endfor %}</ul>
  <h3>Playbook (full)</h3>{% for p in playbook_if_x_then_y|default([]) %}<p class="meta">{{ p }}</p>{% endfor %}
  <h3>Open items</h3><ul>{% for q in open_questions|default([]) %}<li>{{ q }}</li>{% endfor %}</ul>
  <h3>Downtrend v2</h3>
  <p class="mono">Outcome B adj {{ fmt_prob(downtrend_v2.outcome_b_adjusted, 0) }} · Confirmed {{ fmt_prob(downtrend_v2.confirmed_downtrend_adjusted, 0) }}</p>
</section>

</main></div>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
{% set _charts = visualizations_smart.charts | default([]) %}
{% macro chart_data(cid) %}{% set found = _charts | selectattr('id','equalto',cid) | list %}{{ (found[0].data if found else {}) | tojson }}{% endmacro %}
<script type="application/json" id="viz-data-actions">{{ chart_data('actions') }}</script>
<script type="application/json" id="viz-data-fed">{{ chart_data('fed') }}</script>
<script type="application/json" id="viz-data-liq-omo">{{ chart_data('liq-omo') }}</script>
<script type="application/json" id="viz-data-liq-ib">{{ chart_data('liq-ib') }}</script>
<script type="application/json" id="viz-data-breadth">{{ chart_data('breadth') }}</script>
<script>
document.addEventListener('DOMContentLoaded',function(){
  if(typeof Chart==='undefined')return;
  Chart.defaults.color='#7a8399'; Chart.defaults.borderColor='#252a35';
  function pj(id){var el=document.getElementById(id);if(!el)return null;try{return JSON.parse(el.textContent);}catch(e){return null;}}
  const BLUE='#4a9eff',ACCENT='#00c896',DIM='#7a8399';
  const fed=pj('viz-data-fed'); if(fed&&document.getElementById('chart-fed')){new Chart(document.getElementById('chart-fed'),{type:'bar',data:{labels:['Fed cut 3m','VN tighten 1m'],datasets:[{data:[fed.fed_cut_3m||0,fed.vn_tighten_1m||0],backgroundColor:BLUE,borderWidth:0}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}},scales:{y:{min:0,max:1}}}});}
  const omo=pj('viz-data-liq-omo'); if(omo&&document.getElementById('chart-liq-omo')){new Chart(document.getElementById('chart-liq-omo'),{type:'bar',data:{labels:['OMO net (VND bn)'],datasets:[{data:[omo.omo_net||0],backgroundColor:DIM,borderWidth:0}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}}}});}
  const ib=pj('viz-data-liq-ib'); if(ib&&document.getElementById('chart-liq-ib')){new Chart(document.getElementById('chart-liq-ib'),{type:'bar',data:{labels:['Interbank ON (%)'],datasets:[{data:[ib.interbank_on||0],backgroundColor:BLUE,borderWidth:0}]},options:{responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}}}});}
  const br=pj('viz-data-breadth'); if(br&&document.getElementById('chart-breadth')){const v=br.pct_cloud_bull_a3; new Chart(document.getElementById('chart-breadth'),{type:'doughnut',data:{labels:['Bull','Other'],datasets:[{data:[v||0,1-(v||0)],backgroundColor:[ACCENT,DIM],borderWidth:0}]},options:{responsive:true,maintainAspectRatio:false,cutout:'65%'}});}
  const act=pj('viz-data-actions'); if(act&&document.getElementById('chart-actions')){const labels=Object.keys(act),vals=Object.values(act); new Chart(document.getElementById('chart-actions'),{type:'bar',data:{labels,datasets:[{data:vals,backgroundColor:BLUE,borderWidth:0}]},options:{indexAxis:'y',responsive:true,maintainAspectRatio:false,plugins:{legend:{display:false}}}});}
});
</script>
</body></html>
